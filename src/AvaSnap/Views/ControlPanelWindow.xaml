                                                               MouseMove="ToneGradientDarkColorWheel_MouseMove"
                                                               MouseLeftButtonUp="ToneGradientDarkColorWheel_MouseUp" />
                                                        <Border x:Name="ToneGradientDarkColorWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                                BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                    </Grid>
                                                            <Slider x:Name="ToneGradientDarkColorValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    ValueChanged="ToneGradientDarkColorValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                    <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="ToneGradientDarkColorRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="ToneGradientDarkColorRSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="ToneGradientDarkColorRBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="ToneGradientDarkColorRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="ToneGradientDarkColorGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="ToneGradientDarkColorGSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="ToneGradientDarkColorGBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="ToneGradientDarkColorGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="ToneGradientDarkColorBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="ToneGradientDarkColorBSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="ToneGradientDarkColorBBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="ToneGradientDarkColorBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Border x:Name="ToneGradientDarkColorPreviewLarge" Height="28" CornerRadius="6"
                                                            Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <!-- Title-only row, then "・"-prefixed 色/方向/強さ rows, same
                                         3-column (label|control|value) grammar as every plain
                                         slider row, matching the ドロップシャドウ/グラデーション
                                         restructuring. Color picking (LightLeakColorButton/Popup)
                                         is the same custom wheel+RGB UI as ドロップシャドウ's own,
                                         just with its own presets (暖色/寒色/白) and its own
                                         popup/wheel/slider elements below. -->
                                    <!-- 他行と同じ3列 Grid で包む(素の TextBlock ではない)ので、
                                         このラベルが上の行と同じ Column0 に入る。 -->
                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ライトリーク" Style="{StaticResource SliderRowLabel}" Width="116"
                                                   ToolTip="光が差し込む向きと強さを指定します" />
                                    </Grid>
                                    <!-- ・色: a long horizontal swatch bar (matches a slider's own
                                         width) instead of a small square icon, with a hex code
                                         textbox in the value column, same slot a numeric TextBox
                                         occupies on every other row. -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="・色" Style="{StaticResource SliderRowLabel}" Width="116"
                                                   ToolTip="光の色を選択" Opacity="0.7" />
                                        <Button Grid.Column="1" x:Name="LightLeakColorButton" Style="{StaticResource ColorSwatchBarButton}"

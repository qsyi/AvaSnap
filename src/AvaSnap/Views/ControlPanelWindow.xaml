<Window x:Class="AvaSnap.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AvaSnap.Converters"
        Title="AvaSnap"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="420" Height="480"
        MinWidth="360" MinHeight="380"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        FontFamily="pack://application:,,,/Fonts/#Zen Maru Gothic Medium">
    <Window.Resources>
        <conv:SliderZeroFillConverter x:Key="SliderZeroFillConverter" />

        <!-- スポイト(色を拾う)アイコン。全カラーピッカー行の "プレビューから色を
             拾う" ボタンで使い回す。x:Shared="False" なので StaticResource 参照の
             たびに新しいビジュアルツリーが作られる(WPF の Visual は親を1つしか
             持てないため、同一インスタンスの共有は不可)。 -->
        <Viewbox x:Key="EyedropperIcon" x:Shared="False" Width="13" Height="13">
            <Canvas Width="24" Height="24">
                <Path Data="m2 22 1-1h3l9-9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="M3 21v-3l9-9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>

        <!-- 反時計回り矢印(rotate-ccw)。「元に戻す / リセット」系ボタンのラベル
             左に置くアイコン。上のスポイトと同じく x:Shared="False"。 -->
        <Viewbox x:Key="RotateCcwIcon" x:Shared="False" Width="13" Height="13" Margin="0,0,5,0">
            <Canvas Width="24" Height="24">
                <Path Data="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <Path Data="M3 3v5h5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>

        <!-- 画像(lucide image)。「この合成結果を保存」などのボタンラベル左。
             斜線入りの image-off 版は別途インラインのまま。 -->
        <Viewbox x:Key="ImageIcon" x:Shared="False" Width="14" Height="14" Margin="0,0,6,0">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="2" />
                <Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Stroke="White" StrokeThickness="2" />
                <Path Data="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>

        <!-- CompositeLoadingPanel のスピナー弧の連続回転。コードビハインドから
             明示的に開始/停止する(ShowCompositeLoading/HideCompositeLoading)。
             Visibility だけでは Forever リピートアニメーションは開始/停止しない。 -->
        <Storyboard x:Key="CompositeLoadingSpinStoryboard">
            <DoubleAnimation Storyboard.TargetName="CompositeLoadingSpinnerRotate" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
        </Storyboard>
        <!-- Primary/Accent/Success/Background/Text/Hairline/Tint/ScrollThumb/
             PreviewMat ブラシの実際の色値は Themes/LightTheme.xaml と
             Themes/DarkTheme.xaml にあり、ThemeService が起動時にどちらかを
             Application.Resources へマージする(ダークモードトグルで実行時に切替)。
             以下のブラシキー参照はすべて DynamicResource ── StaticResource は
             読み込み時に1回解決され、後のテーマ切替を拾わないため。 -->

        <!-- 窓内の全 ToolTip の吹き出し風スタイル(TargetType 指定なし、
             SliderThumbStyle と同じ手法): 細枠の白箱ではなく PrimaryBrush で塗った
             白文字の吹き出しにして、明るい背景に対して「浮くラベル」として読ませる。
             しっぽは同色・無ストロークの 45 度回転した四角を Border の背面に大半を
             隠して置き、下の角だけを尖りとして覗かせる。VerticalOffset は小さく(2)
             して吹き出しがホバー対象のすぐ下に来るようにする。 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid Margin="4">
                            <Rectangle Width="12" Height="12" Fill="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,1,0,0">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" CenterX="6" CenterY="6" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="11,8" MaxWidth="240" Margin="0,6,0,0">
                                <!-- ContentPresenter ではなく Content にバインドした
                                     素の TextBlock: ここの ToolTip はすべて文字列
                                     (ToolTip="...")なので常にテキストがあり、
                                     TextWrapping は TextElement の添付プロパティでは
                                     ないので ContentPresenter には同じように設定できない。 -->
                                <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                           FontSize="13.5" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- SecondaryPillButtonのIsEnabled=False版。元のPillButtonテンプレートには
             無効時のトリガーが無く(ボタンとしては押せなくなるだけで見た目は
             変わらない)、CompositeSkipAvatarButtonのような「一度きりの操作、
             実行後は無効化されたまま」というボタンにはそのままでは使えない。 -->
        <Style x:Key="SecondaryPillButtonDimmable" TargetType="Button" BasedOn="{StaticResource SecondaryPillButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- アバタールックと写真ルックを連動させるかのトグル: 既定はオフ(独立)。
             チェック時に内容/色が反転し、別ラベル無しでも連動状態が一目で分かる。 -->
        <Style x:Key="LinkToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="一括調整オフ" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <!-- Lucide "link" アイコン(ISC ライセンス)。Stroke は
                                     ToggleButton の Foreground に追従する(下の IsChecked
                                     トリガーで TextSecondaryBrush/White)── Path の Stroke は
                                     TextBlock と違い Foreground を継承しないため。 -->
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Path Data="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Content" Value="一括調整オン" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented-control look for a mutually-exclusive multi-way choice
             (currently キャンバス比率's 5 presets): plain RadioButtons with
             GroupName tying them together for exclusivity, styled as small
             pill buttons instead of the default circle+dot, same flip-
             color-when-selected treatment as LinkToggleButton above. -->
        <Style x:Key="AspectRatioRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- AspectRatioRadioButton の ToggleButton 版。オン/オフが一目で分かる
             ピル(オフ=グレー / オン=PrimaryBrush 塗り + 白文字)。マスク編集の
             「反転」など単独トグル用。 -->
        <Style x:Key="PillToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <!-- ドロップシャドウ無し: カードは影ではなく AppBackgroundBrush との
                 フラットな色コントラストで見分ける。 -->
        </Style>

        <!-- CardのIsEnabled=False版。プレーンなBorderはIsEnabled=Falseでも
             見た目が変わらない(内部のSlider/TextBox個々が既定テーマの
             薄い無効表示になるだけ)ので、カード全体をグレーアウトして
             見せたいAvatarLookCard/PhotoLookCard用に不透明度を落とす
             トリガーを足す(SecondaryPillButtonDimmableと同じ考え方)。 -->
        <Style x:Key="DimmableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <!-- No trigger here previously: IsEnabled=False
                             disabled the box functionally (no typing/focus)
                             but looked IDENTICAL to enabled, since this
                             custom template replaces WPF's own default
                             disabled-state visuals entirely. Every grayed-
                             out-while-synced field (FOVガイドのFOV/ピッチ/
                             ロール欄など) silently relied on this and looked
                             like nothing had changed. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button (currently just ライトリーク's rotate
             control): same tinted-pill hover treatment as NavSegmentButton,
             scaled down to sit beside a CompactComboBox in a slider row. -->
        <Style x:Key="RotateIconButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontally elongated color swatch button (ドロップシャドウ/
             ライトリークの「・色」row): starts nudged in a bit from the
             column's own left edge (small left Margin, not flush at x=0),
             then Stretches to fill the rest of the column all the way to
             the hex textbox, instead of stopping at a fixed width and
             leaving a gap. Content is expected to be a Border whose own
             Background carries the actual color; this style just makes the
             ContentPresenter stretch to fill so that Border reaches every
             edge. -->
        <Style x:Key="ColorSwatchBarButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <!-- ホバー表現に背景ティントは使えない(ボタンの
                                 「背景」が選択色そのものなので色が誤って見える)。
                                 代わりに半透明の白を上に重ねる。 -->
                            <Border x:Name="HoverOverlay" CornerRadius="5" Background="White" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 合成モードのプレビューとカード列の間のドラッグ可能な仕切り
             (CompositePanel の 6px スプリッタ列)。通常は中央の細いヘアラインで
             重い境界に見えないようにし、ホバーで 6px のヒット領域全体に広がって
             PrimaryBrush になり、常時うるさくせずドラッグ可能だと分かる。 -->
        <Style x:Key="PreviewCardsSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Line" Width="1" Background="{DynamicResource HairlineBrush}" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Generic iOS-style ON/OFF switch: no baked-in text, just a track
             that changes color and a thumb that slides side to side, meant
             to sit next to its own plain TextBlock label (see Unity
             連携ガイド's 表示/同期 toggles). -->
        <Style x:Key="SwitchToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource HairlineBrush}" CornerRadius="9">
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークモードスイッチ: SwitchToggleButton をやや広くした版(34x18 →
             40x20)で、タイトルバーから一目でトグルと分かるようにする。太陽/月
             アイコンは Track 固定ではなくスライドする Thumb 内(常に白丸の上)に
             乗るので、Track がどの色でも読める。 -->
        <Style x:Key="ThemeSwitchToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource HairlineBrush}" CornerRadius="10">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Grid>
                                    <!-- Lucide "sun" アイコン(ISC ライセンス)。 -->
                                    <Viewbox x:Name="SunIcon" Width="10" Height="10">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                                            <Path Data="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Lucide "moon" アイコン(ISC ライセンス)。 -->
                                    <Viewbox x:Name="MoonIcon" Width="10" Height="10" Visibility="Collapsed">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"
                                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="SunIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MoonIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小さな四角のプリセットスウォッチ(DropShadowColorPopup のクイックピック行):
             アイコン無しのべた塗り四角。他の小四角ボタン(RotateIconButton)に合わせて角丸。 -->
        <Style x:Key="ColorPresetButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small dropdown for picking among a handful of named presets
             (currently ライトリーク's shape and its warm/cool mode).
             Re-templated (not just the default ComboBox chrome/popup with a
             few colors tweaked) since the native Windows combo box's square
             edges and plain arrow read as out of place next to this app's
             rounded, soft-shadowed cards/buttons/sliders everywhere else. -->
        <Style x:Key="CompactComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="3,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <ToggleButton Style="{StaticResource CompactComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="&#9662;" FontSize="10" Margin="4,0,0,0"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="0,3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- 1行のスライダーフィールド: ラベル | スライダー | 数値ボックス
             (縦3段ではなく)。ラベルとボックスは固定幅で、カード内の各行がそろう。 -->
        <Style x:Key="SliderRowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <!-- 116(90 から拡大): 仕上げエフェクトの慣例に合わせる
                 (「ドロップシャドウ」「ライトリーク」が切れないため)。合成画面の
                 全スライダーが同じトラック長でそろう。 -->
            <Setter Property="Width" Value="116" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- ToolTip 表示の既定ホバー遅延(約400-500ms)は、スライダー調整中に
                 ちらっと見る用途には遅い。 -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        </Style>
        <Style x:Key="SliderRowBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <!-- 60(52 から拡大): FontSize 13 だと「100」「360」など3桁が旧 52px
                 幅で切れていた。行の見た目を大きく変えない最小限の拡大にとどめる。 -->
            <Setter Property="Width" Value="60" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上部バーのホーム/最小化/モード切替ボタンは1グループとして隣接する。
             共通の淡いティントのピル背景(3つとも同色)で「まとまり」に見せる。 -->
        <Style x:Key="NavPillButton" TargetType="Button" BasedOn="{StaticResource BackButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ホーム/最小化/モード切替を、3つの浮いたピルではなく1つのセグメント
             コントロールにする: ティントの角丸コンテナ(下の NavSegmentGroup)が
             これらをフラットな矩形にクリップし、外側の角だけ丸める。セグメント間は
             ヘアライン区切り。ホバーハイライトがボタンごとの Border なので3バリアント。
             先頭/末尾は外側の角をグループの角に合わせて丸める必要がある。 -->
        <Style x:Key="NavSegmentButton" TargetType="Button" BasedOn="{StaticResource BackButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSegmentButtonFirst" TargetType="Button" BasedOn="{StaticResource NavSegmentButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10,0,0,10">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSegmentButtonLast" TargetType="Button" BasedOn="{StaticResource NavSegmentButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="0,10,10,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryTintHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="NavSegmentDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
        </Style>


        <!-- カスタムタイトルバーの閉じるボタン: Windows 標準の「ホバーで赤」見た目。 -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E53935" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- カスタムタイトルバーの最小化ボタン: 形は TitleBarCloseButton と同じだが
             ホバーは赤ではなく中立のヘアライン(最小化は破壊的操作ではない)。
             位置合わせ/合成モードで共有する。 -->
        <Style x:Key="TitleBarMinimizeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HairlineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- スライダー: Minimum ではなくゼロ点から thumb まで色を塗る。-100..100
             系のスライダーは 0 で半分ではなく空に見えるべき。SliderZeroFillConverter が
             計算する。Minimum が既に 0 のスライダー(境界ぼかし、不透明度)ではゼロ点が
             左端なので、自動的に通常の左詰めバーに退化する。丸 thumb、影なし。
             窓内の全 Slider に自動適用(TargetType 指定なし)。 -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{DynamicResource PrimaryBrush}" Stroke="White" StrokeThickness="2" />
                        <!-- IsEnabled は Slider からこの Thumb へ自動継承されるので
                             このトリガーだけで十分(コードビハインド不要)。無効時は
                             ハンドルをグレーにしカーソルを変えて、ドラッグ不可だと分かる
                             ようにする。 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="Dot" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <!-- PART_Track のクリックジャンプとドラッグ追従はどちらも
                 コードビハインド(SliderTrack_Preview*)で明示的に処理する。
                 IsMoveToPointEnabled は使わない ── 組込機構の内部の擬似 Thumb 押下が、
                 トラック外へ出ても追従し続けるための明示的マウスキャプチャと競合した。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderGrid" Height="24">
                            <Border Height="4" Background="{DynamicResource HairlineBrush}" CornerRadius="2" VerticalAlignment="Center" />
                            <Border x:Name="Fill" Height="4" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" VerticalAlignment="Center">
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource SliderZeroFillConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding ElementName="SliderGrid" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Margin>
                            </Border>
                            <!-- IsMoveToPointEnabled はクリック位置へ thumb を
                                 飛ばすが、そのまま押しっぱなしでドラッグしても
                                 このアプリの透明 RepeatButton スタイルでは追従が
                                 安定しないので、下の PART_Track が継続処理する
                                 (SliderTrack_PreviewMouseMove 参照)。Thumb 自体への
                                 クリックは触らない。 -->
                            <Track x:Name="PART_Track" VerticalAlignment="Center"
                                   PreviewMouseLeftButtonDown="SliderTrack_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="SliderTrack_PreviewMouseMove"
                                   PreviewMouseLeftButtonUp="SliderTrack_PreviewMouseLeftButtonUp">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <!-- CompareSlider は Tag="NoFill" を設定する ── 青い進捗バーは
                             「どれだけ完了したか」に見え、ビフォー/アフターの分割位置には
                             合わない。 -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="NoFill">
                                <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <!-- Thumb の IsEnabled=False トリガー(SliderThumbStyle)は
                                 ハンドルをグレーにする。これはトラックの塗り部分も
                                 同様に薄くし、無効スライダーが全長で「操作不可」に見えるようにする。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 明度専用の縦スライダー(全カラーピッカー共通)。白(上)→黒(下)の
             グラデーション帯そのものをトラックにして、その上を丸つまみ
             (SliderThumbStyle)が滑る。色相環の右に Height=140 で置く前提。
             既定の Slider テンプレートは横用にレイアウトが固定されていて、
             Orientation=Vertical にすると丸が 24px 枠内に留まってグラデーション
             とずれるので、縦専用テンプレートにする。IsDirectionReversed=True で
             上=最大(明るい)= グラデーションの白側に合わせる。 -->
        <Style x:Key="BrightnessSliderVertical" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Width" Value="22" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="12" HorizontalAlignment="Center" CornerRadius="6"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="White" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Track.Orientation は Slider の既定テンプレートが
                                 縦横で別テンプレートを持つように、TemplatedParent
                                 からは自動で来ないため明示が必要。既定の縦 Track
                                 (IsDirectionReversed=false)は最小=下・最大=上なので、
                                 明度100(明るい)がグラデーションの白い上端に一致する。 -->
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar: 細い浮きピル(通常 HairlineBrush、ホバー/ドラッグで濃く)、
             矢印ボタン無し。Windows 標準の太いグレーバーではなく上の SliderThumbStyle と
             同じ角丸/フラットな見た目。line-up/down の RepeatButton は削除せずゼロ
             サイズにする ── ScrollBar の既定テンプレートはホイール/キーボード
             スクロールのルーティング先として PART_LineUpButton/PART_LineDownButton の
             存在を前提にするため。 -->
        <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Width="0" Height="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bg" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PART_LineUpButton" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PART_LineDownButton" Style="{StaticResource ScrollBarLineButton}" Command="ScrollBar.LineDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 明示的な AdornerLayer ホスト: WindowStyle="None" + 自作のコンテンツツリー
         では、既定 Window テンプレートの AdornerDecorator の存在を当てにできない。
         LookLinkConnector のアドーナー(ControlPanelWindow.xaml.cs)が付ける先が要る。 -->
    <AdornerDecorator>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- カスタムタイトルバー: WindowStyle="None" でネイティブのを外したので
             ドラッグと閉じるは自前。不透明のまま(AllowsTransparency なし)にして
             ハードウェアアクセラレーションを保つ。Height=32 と最小化/最大化/閉じる
             ボタン(幅 46px)は Windows 10/11 標準のキャプションバーに合わせる。 -->
        <Grid Grid.Row="0" Height="32" Background="{DynamicResource CardBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                <TextBlock Text="AvaSnap" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock x:Name="TitleBarVersionText" Text="" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <!-- App.xaml.cs のバックグラウンド CheckForUpdatesAsync が新しい
                     ビルドを見つけるまで Collapsed(ShowUpdateAvailableNotification)。
                     このボタン自体が通知(他にバッジは無い)で、共有タイトルバーに
                     あるので全モードで見える。押すとバージョン情報の更新セクションを
                     開き、自身は再び隠れる。 -->
                <Button x:Name="TitleBarUpdateButton" Style="{StaticResource TitleBarMinimizeButton}"
                        Padding="10,0" Margin="0,4,4,4" Visibility="Collapsed"
                        Click="TitleBarUpdateButton_Click" ToolTip="新しいバージョンがあります">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <!-- Lucide "download" アイコン(ISC ライセンス)。 -->
                                <Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M7 10l5 5 5-5" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M12 15V3" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="アップデート" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ダークモードトグル: どの画面が開いていても右上から常に届く
                     (タイトルバーは全画面共通)。一目でトグルと分かる幅広スイッチ。
                     スライド thumb 上の太陽/月アイコンが現在のモードを示す。 -->
                <ToggleButton x:Name="ThemeToggleButton" Style="{StaticResource ThemeSwitchToggleButton}"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="ThemeToggleButton_Changed" Unchecked="ThemeToggleButton_Changed"
                              ToolTip="ダークモードの切り替え" />

                <!-- 位置合わせ/合成モードが開いているときだけ意味を持ち表示される。
                     OS の最小化ではなく、窓を CompactPanel の隅の小ウィジェットに
                     縮める(EnterCompact/TitleBarMinimizeButton_Click)。だから
                     ただの「_」ではなく専用アイコン。 -->
                <Button x:Name="TitleBarMinimizeButton" Style="{StaticResource TitleBarMinimizeButton}" Width="46" Height="32"
                        Visibility="Collapsed" Click="TitleBarMinimizeButton_Click" ToolTip="最小化">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <!-- Lucide "minimize-2" アイコン(ISC ライセンス): 内向きの斜め矢印。 -->
                            <Path Data="m14 10 7-7" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Data="M20 10h-6V4" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Data="m3 21 7-7" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Data="M4 14h6v6" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 本物の最大化/復元(TitleBarMaximizeButton_Click)。
                     WindowState.Maximized を使い、WM_GETMINMAXINFO フックで
                     WindowStyle=None + Maximized のタスクバー重なりバグを回避する。
                     コンパクトモードでは非表示(ExpandButton が拡大を担うため)。 -->
                <Button x:Name="TitleBarMaximizeButton" Style="{StaticResource TitleBarMinimizeButton}" Width="46" Height="32"
                        Click="TitleBarMaximizeButton_Click" ToolTip="最大化">
                    <Grid>
                        <Viewbox x:Name="MaximizeIcon" Width="12" Height="12">
                            <Rectangle Width="20" Height="20" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                        </Viewbox>
                        <Viewbox x:Name="RestoreIcon" Width="13" Height="13" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="6" Canvas.Top="0" Width="18" Height="18"
                                           Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                                <Rectangle Canvas.Left="0" Canvas.Top="6" Width="18" Height="18"
                                           Fill="{DynamicResource CardBackgroundBrush}"
                                           Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TitleBarCloseButton}" Width="46" Height="32" Click="CloseButton_Click">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path Data="M18 6 6 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="m6 6 12 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ホーム: モード選択。設定アイコンはこの行の隅に置く(HomePanel の中央
             StackPanel の中ではない)ので、モードカード/設定パネルの高さに
             関わらず固定の隅に留まる。 -->
        <Button x:Name="HomeSettingsToggle" Grid.Row="1" Style="{StaticResource NavPillButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Padding="9,9" Click="HomeSettingsToggle_Click">
            <!-- Lucide "settings" 歯車アイコン(ISC ライセンス)。旧絵文字の置き換え。 -->
            <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                    <Path Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                             Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                </Canvas>
            </Viewbox>
        </Button>


        <StackPanel x:Name="HomePanel" Grid.Row="1" Margin="22" VerticalAlignment="Center">
            <TextBlock Text="AvaSnap" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,2" />
            <TextBlock Text="VRChatカメラ合成・レタッチツール" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="位置合わせモード" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="VRChatのカメラ枠にアバター画像を合わせて配置します" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <!-- FontSize を PillButton の拡大前サイズに明示的に戻す:
                         このボタン(と下の同様のもの)はホーム画面にあり、他のフォントを
                         大きくした後も元のサイズを保つよう指定された。共有スタイルは
                         他所で拡大サイズのまま使われるので、スタイル自体は戻せない。 -->
                    <Button Content="開く" Style="{StaticResource PillButton}" FontSize="13" HorizontalAlignment="Left"
                            Click="AlignModeButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="レタッチモード" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="画像を色調補正・トリミング・エフェクトで仕上げます。写真とアバター画像の合成にも対応。" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <Button Content="開く" Style="{StaticResource SecondaryPillButton}" FontSize="13" HorizontalAlignment="Left"
                            Click="CompositeModeButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- スクショ監視フォルダ設定: 専用カード。歯車ボタンの真下・同じ隅に
             アンカーする(中央のモード選択 StackPanel に混ぜない)ので、
             「そのボタンから降りてきたパネル」に見える。 -->
        <Border x:Name="HomeSettingsPanel" Grid.Row="1" Style="{StaticResource Card}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="230"
                Margin="0,64,16,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="スクリーンショット監視フォルダ" Style="{StaticResource SectionHeader}" FontSize="12" />
                <TextBlock x:Name="WatchFolderText" Text="" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ChangeWatchFolderButton" Content="変更…" Style="{StaticResource SecondaryPillButton}" FontSize="13"
                            Padding="14,6" Margin="0,0,8,0" Click="ChangeWatchFolderButton_Click" />
                    <Button x:Name="ResetWatchFolderButton" Content="自動検出に戻す" Style="{StaticResource BackButton}" FontSize="13"
                            Click="ResetWatchFolderButton_Click" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,14,0,10" />
                <Button Style="{StaticResource SecondaryPillButton}" FontSize="13"
                        HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,8" Click="AboutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- Lucide "info" アイコン(ISC ライセンス)。 -->
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Stroke="White" StrokeThickness="2" />
                                <Path Data="M12 16v-4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="11" Canvas.Top="7.5" Width="2" Height="2" Fill="White" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="バージョン情報" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="ライセンス" Style="{StaticResource BackButton}" FontSize="13"
                        HorizontalAlignment="Left" Click="LicenseButton_Click" />

                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,10,0,10" />
                <!-- ユーザー提供のGoogleフォームへの外部リンク。ブラウザで
                     開くだけで、アプリ内には何も保存/送信しない。 -->
                <Button Style="{StaticResource SecondaryPillButton}" FontSize="13"
                        HorizontalAlignment="Left" Padding="14,6" Click="FeedbackButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- Lucide "message-square" アイコン(ISC ライセンス)。 -->
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                                      Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="ご意見・改善要望" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 位置合わせモード -->
        <Grid x:Name="AlignPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource NavSegmentGroup}" HorizontalAlignment="Left" Margin="16,14,16,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource NavSegmentButtonFirst}" Click="BackToHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- Lucide "house" アイコン(ISC ライセンス)。旧絵文字の
                                 置き換えで、解像度非依存のラインアイコン。 -->
                            <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"
                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="ホーム" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource NavSegmentDivider}" />
                    <Button Content="レタッチモードへ" Style="{StaticResource NavSegmentButtonLast}" Click="CompositeModeButton_Click" />
                </StackPanel>
            </Border>

            <!-- 3状態: (1)OSC 未検知/ポート競合 → OSC 有効化ヒント + 手順ボタン、
                 (2)OSC は動作中だがカメラ未オープン → 「カメラを開いて」、
                 (3)カメラ オープン → 非表示。RefreshAlignBanner が切り替える。 -->
            <Border x:Name="CameraClosedBanner" Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                    CornerRadius="8" Margin="16,10,16,0" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CameraClosedBannerText" Text="VRChatのカメラを開いてください" FontSize="17" FontWeight="Bold"
                               Foreground="#7A5B00" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="OscSetupGuideButton" Content="OSCを有効にする手順" Style="{StaticResource PillButton}"
                            FontSize="12" Padding="12,5" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Visibility="Collapsed" Click="OpenOscSetupGuideButton_Click" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,14">
                <Button x:Name="LoadImageButton" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="LoadImageButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ContentPresenter Content="{StaticResource ImageIcon}" />
                                <TextBlock Text="アバター画像を読み込む" />
                            </StackPanel>
                </Button>
                <TextBlock x:Name="ImagePathText" Text="(アバター画像未読み込み)" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6" />
                <!-- コードで生成(PopulateThumbnailRow)。行幅に収まるぶんだけ
                     最近使ったアバター画像を新しい順に並べる。クリックで直接読み込み、
                     エクスプローラーを開き直さずに済む。 -->
                <StackPanel x:Name="AlignRecentAvatarsPanel" Orientation="Horizontal" Margin="0,0,0,10"
                            SizeChanged="AlignRecentAvatarsPanel_SizeChanged" />

                <Button x:Name="ResetButton" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="ResetButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                        <TextBlock Text="位置をリセット" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ResetStatusText" Text="" Foreground="{DynamicResource AccentDarkBrush}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- 旧「クリックスルー: ON/OFF」表示の置き換え。裏側の仕組みではなく
                     ユーザーができること(Shift 押下中に移動/リサイズ)を説明する。 -->
                <TextBlock Text="Shiftキーを押しながらだと、この画像を移動・拡大縮小できます"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <!-- 1カード: 位置/サイズ/回転/不透明度/境界ぼかし。色調ルック
                     (明るさ、コントラスト等)は以前ここにも専用カードがあったが、
                     位置合わせではなく合成モード固有の関心事で、合成モードの
                     アバタールックカード(同じ OverlayState)と重複していたので削除。 -->
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="位置・サイズ" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="表示" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.7" />
                                    <!-- アバター画像そのものの表示/非表示。不透明度(Opacity)は0
                                         にしても位置合わせ用のハンドルは残るのに対し、こちらは
                                         画像もハンドルも完全に隠して背景(VRChatの生の映像)だけを
                                         見比べたい時用。値はIsClickThrough同様、編集ではなくモード
                                         切替なのでUndo対象外(UndoManagerのOverlaySnapshotに含めない)。 -->
                                    <ToggleButton x:Name="ImageVisibleToggle" Style="{StaticResource SwitchToggleButton}"
                                                  Checked="ImageVisibleToggle_Changed" Unchecked="ImageVisibleToggle_Changed"
                                                  ToolTip="アバター画像を表示/非表示" />
                                </StackPanel>
                            </Grid>
                            <!-- X/Y/幅/高さ/回転(度) スライダーは削除: この窓
                                 (OverlayWindow)には既にドラッグ/隅リサイズ/回転ギズモの
                                 ハンドル系(Handle_*/RotateGizmo_*)があり、これが実際の
                                 主な配置手段。これらは同じ _state.X/Y/Width/Height/
                                 RotationDegrees の冗長な2つ目のUIだった。下の不透明度は
                                 プレビュー上のドラッグ相当が無い唯一のフィールド
                                 (位置合わせ専用の視認補助で合成には焼き込まれない)
                                 なので、これだけスライダーを残す。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="不透明度 (%)" Style="{StaticResource SliderRowLabel}" ToolTip="画像の透明度。位置合わせ時の見やすさ用で、実際の合成結果には反映されません" />
                                <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100" Ticks="50,100" VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp" />
                                <TextBox Grid.Column="2" x:Name="OpacityBox" Style="{StaticResource SliderRowBox}" TextChanged="OpacityBox_TextChanged"
                                          GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                            </Grid>
                            <!-- 境界ぼかしは位置合わせモードからは削除 (Composite
                                 モードの「アバター画像の見た目」カード側の
                                 CompositeEdgeBlurSlider/Boxに残っている。同じ
                                 _state.EdgeBlurRadiusを共有、同じハンドラー
                                 (EdgeBlurSlider_ValueChanged等)はsenderを見て
                                 汎用的に書かれているのでそちらは無変更で動く)。 -->
                            <!-- ResetButton(上部の「位置をリセット」)と同じ
                                 PerformReset()を呼ぶだけの、他カードのリセット
                                 ボタンと見た目を揃えたショートカット。既存の
                                 上部ボタンは残したまま、このカード内単独でも
                                 押せるように追加。 -->
                            <Button Style="{StaticResource SecondaryPillButton}"
                                    HorizontalAlignment="Left" Click="ResetButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                                    <TextBlock Text="リセット" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Border>

                        <!-- FOVガイド: 表示トグルはガイド線の表示/非表示のみ。
                             FOV/ピッチ/ロールはOverlayStateのGuideManualFov/
                             Pitch/Rollが唯一の値で、常に手入力可能(取得ボタンで
                             Unityから取得した値もここへ直接書き込まれるだけで、
                             手入力と取得を切り替えるモードは無い)。
                             UnityConnectionBadge/Textは常時ステータス表示では
                             なく、UnityCameraGuideService.DataUpdatedが発火
                             した時だけ「取得しました」を数秒表示して消える
                             一時的な通知(ShowGuideFetchedNotification)。 -->
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="FOVガイド" Style="{StaticResource SectionHeader}"
                                                   Margin="0" VerticalAlignment="Center" />
                                        <Border x:Name="UnityConnectionBadge" CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Background="{DynamicResource PrimaryTintBrush}"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="UnityConnectionText" Text="取得しました" FontSize="11"
                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                        </Border>
                                        <!-- UnityCameraGuideService.FilePathをエクスプローラーで
                                             選択表示する。ファイルが実在するか/更新日時を直接
                                             確認したい時用(接続状況バッジだけでは分からない詳細)。 -->
                                        <Button x:Name="OpenGuideFileButton" Style="{StaticResource RotateIconButton}"
                                                Margin="6,0,0,0" Click="OpenGuideFileButton_Click"
                                                ToolTip="エクスポートファイルの場所をエクスプローラーで開く">
                                            <Viewbox Width="13" Height="13">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Lucide "folder" アイコン(ISC ライセンス)。 -->
                                                    <Path Data="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"
                                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBlock Text="表示" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                                   Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.7" />
                                        <ToggleButton x:Name="GuideVisibleToggle" Style="{StaticResource SwitchToggleButton}"
                                                      Checked="GuideVisibleToggle_Changed" Unchecked="GuideVisibleToggle_Changed"
                                                      ToolTip="ガイド線をVRChatの画面上に表示" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <!-- Unity側は常時ポーリングではなくリクエスト待機
                                             (FileSystemWatcher)のみなので、値を更新するには
                                             この取得ボタンを押す必要がある。押しても応答が
                                             来るとは限らない(Unity未起動/応答トグルOFF)ので
                                             送りっぱなし。結果はUnityConnectionText/
                                             DataUpdated側で分かる(下の数値へ直接書き込まれる)。 -->
                                        <TextBlock Text="取得" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                                   Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.7" />
                                        <Button x:Name="RequestGuideButton" Style="{StaticResource RotateIconButton}"
                                                Margin="6,0,0,0" Click="RequestGuideButton_Click"
                                                ToolTip="Unityからfovを取得">
                                            <Viewbox Width="13" Height="13">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Lucide "refresh-cw" アイコン(ISC ライセンス)。 -->
                                                    <Path Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M3 3v5h5" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"
                                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M16 16h5v5" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Unity EditorはOSフォーカスを失うとEditorApplication.update
                                     の頻度を大きく落とすため、取得ボタンを押した直後(Unity側が
                                     非フォーカス)は反映が遅れることがある。Unity側の仕様で
                                     こちらの実装では解消できないため、常時表示のヒントとして
                                     明示しておく。 -->
                                <TextBlock Text="取得ボタンを押してUnityをフォーカスすると反映されます" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                <!-- Unity側の準備(VCCへのリポジトリ登録+プロジェクトへの
                                     パッケージ追加)を案内する、上から降りてくるガイドパネル
                                     (UnityIntegrationGuideOverlay、Windowルートの一番下=
                                     最前面に宣言)を開くボタン。リンク風だと見つけにくいので
                                     アイコン付きのピルボタンにする。 -->
                                <Button Style="{StaticResource SecondaryPillButton}"
                                        Click="OpenUnityIntegrationGuideButton_Click"
                                        HorizontalAlignment="Left" Margin="0,0,0,8" Padding="12,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide "book-open" アイコン(ISC ライセンス)。 -->
                                                <Path Data="M12 7v14M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
                                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Unity連携のセットアップ手順" />
                                    </StackPanel>
                                </Button>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FOV" Style="{StaticResource SliderRowLabel}" />
                                    <Slider Grid.Column="1" x:Name="GuideFovSlider" Minimum="20" Maximum="150" VerticalAlignment="Center"
                                            ValueChanged="GuideFovSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp" />
                                    <TextBox Grid.Column="2" x:Name="GuideFovBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="GuideFovBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- VRChatのカメラUIにFOVの数値表示はなく、
                                     Zスライダーの目盛りのみなので、実測の
                                     参考値をヒントとして表示するだけに留める
                                     (スライダー位置との厳密な対応は未確認)。 -->
                                <TextBlock Text="ヒント: VRChatカメラのデフォルトFOVは45、ズーム最大(最も望遠)で20"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ピッチ" Style="{StaticResource SliderRowLabel}" ToolTip="カメラの上下の傾き(度)" />
                                    <Slider Grid.Column="1" x:Name="GuidePitchSlider" Minimum="-60" Maximum="60" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="GuidePitchSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp" />
                                    <TextBox Grid.Column="2" x:Name="GuidePitchBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="GuidePitchBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ロール" Style="{StaticResource SliderRowLabel}" ToolTip="カメラの傾き(度)" />
                                    <Slider Grid.Column="1" x:Name="GuideRollSlider" Minimum="-45" Maximum="45" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="GuideRollSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp" />
                                    <TextBox Grid.Column="2" x:Name="GuideRollBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="GuideRollBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                            </StackPanel>
                        </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 合成モード -->
        <Grid x:Name="CompositePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 下のプレビュー/カード分割(ScrollViewer の Grid.RowSpan="2")に合わせ、
                 ナビバーの列をプレビュー幅に収め、カード列を最上部から始められるように
                 する。間のスプリッタ列(PreviewCardsSplitter)でプレビュー/カード比を
                 ドラッグ変更できる。両側とも MinWidth を持つのでどちらも潰せない。 -->
            <!-- 均等な 1*/1* ではなく 3*/2*(約 60/40、プレビュー寄り): スプリッタを
                 最後にドラッグした位置を新しい既定にしたもの。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,14,16,8">
                <Border Style="{StaticResource NavSegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NavSegmentButtonFirst}" Click="BackToHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- Lucide "house" アイコン(ISC ライセンス)。旧絵文字の
                                     置き換えで、解像度非依存のラインアイコン。 -->
                                <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"
                                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Path Data="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ホーム" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource NavSegmentDivider}" />
                        <Button Content="位置合わせモードへ" Style="{StaticResource NavSegmentButtonLast}" Click="AlignModeButton_Click" />
                    </StackPanel>
                </Border>

                <!-- プロジェクト: 手動保存は無く自動保存。「新規プロジェクト」で日時名の
                     新ファイルへ切り替える(ControlPanelWindow.Project.cs)。 -->
                <Button Style="{StaticResource SecondaryPillButton}" Margin="10,0,0,0" Padding="12,6" FontSize="13"
                        Click="NewProjectButton_Click" ToolTip="現在のプロジェクトは自動保存され、新しい空のプロジェクトを開きます">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M14 3v4a1 1 0 0 0 1 1h4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M12 11v6M9 14h6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="新規プロジェクト" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ProjectNameText" Text="" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </StackPanel>

                <!-- プレビュー -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="16,2,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 読み込んだ画像の周りにカード枠(角丸/背景/境界)は無く、
                         PreviewBorder の個別クリップも無い。ペイン全体をこの1色の
                         フラットな台紙で埋めてここで1回クリップするだけ。プレビュー
                         (ズーム表示含む)がペインの空きを常に使える。 -->
                    <!-- MouseWheel はここにも配線する(PreviewImage だけでなく):
                         レターボックスの余白上のスクロールは PreviewImage の描画外なので
                         以前は何も起きなかった。ハンドラは sender を使わず e.Handled=true を
                         立てるので、画像上の直接スクロールも1回だけ発火する。 -->
                    <Grid Grid.Row="0" x:Name="PreviewHost" Background="{DynamicResource PreviewMatBrush}"
                          ClipToBounds="True" SizeChanged="PreviewHost_SizeChanged" MouseWheel="PreviewImage_MouseWheel">
                    <!-- 今は純粋なレイアウト箱(Style/背景/境界/クリップ無し):
                         Width/Height は SizePreviewToImage で画像の縦横比に合わせて
                         計算され、下の CompareSlider/CompareSplitLine のサイズ/位置
                         計算がそれに依存する。 -->
                    <Border x:Name="PreviewBorder">
                        <Grid>
                            <!-- PreviewImage と CompareSplitLine はこのラッパー Grid の
                                 RenderTransform を共有するので、分割線が画像と一緒に
                                 ズーム/パンする。下の CompositeLoadingPanel/
                                 UndoRedoReactionBadge はあえてこのラッパーの外:
                                 画像コンテンツではなくペイン中央の UI なのでズーム/パンしない。 -->
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="PreviewImageScale" />
                                        <TranslateTransform x:Name="PreviewImageTranslate" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Cursor="SizeAll"
                                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                       MouseMove="PreviewImage_MouseMove"
                                       MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                                       MouseWheel="PreviewImage_MouseWheel"
                                       MouseLeave="PreviewImage_MouseLeave" />
                                <!-- 分割保存(SplitCountBox >= 2)の区切り線。コード側で
                                     PreviewBorder 座標系に縦線を並べる(UpdateSplitGuides)。 -->
                                <Canvas x:Name="SplitGuideLayer" IsHitTestVisible="False" />
                                <!-- マスク編集モード: 切り抜き後キャンバス(=正規化[0,1])に
                                     1:1 対応。MaskEditOverlay がマスクを黒で可視化
                                     (不透明度 = (1-効果)*80%)、MaskEditSurface が
                                     ブラシ/グラデーションの操作面、MaskEditLayer が
                                     ブラシカーソルとグラデーションのハンドル。
                                     いずれも編集モード中のみ Visible(ControlPanelWindow.Masks.cs)。 -->
                                <Image x:Name="MaskEditOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
                                <Border x:Name="MaskEditSurface" Background="Transparent" Cursor="None" Visibility="Collapsed"
                                        MouseLeftButtonDown="MaskEditSurface_MouseLeftButtonDown"
                                        MouseMove="MaskEditSurface_MouseMove"
                                        MouseLeftButtonUp="MaskEditSurface_MouseLeftButtonUp"
                                        MouseEnter="MaskEditSurface_MouseEnter"
                                        MouseLeave="MaskEditSurface_MouseLeave" />
                                <Canvas x:Name="MaskEditLayer" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Line x:Name="MaskGradLine" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="MaskGradRing" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed" />
                                    <Ellipse x:Name="MaskGradHandleA" Width="14" Height="14" Fill="{DynamicResource PrimaryBrush}"
                                             Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse x:Name="MaskGradHandleB" Width="14" Height="14" Fill="White"
                                             Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                    <!-- 外円 = ブラシ直径。内円(破線) = ぼかしの芯
                                         (これより内は効果100%、ここから外円までがなだらか)。 -->
                                    <Ellipse x:Name="MaskBrushCursor" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed" />
                                    <Ellipse x:Name="MaskBrushInnerCursor" Stroke="White" StrokeThickness="1"
                                             StrokeDashArray="2 2" Opacity="0.7" Visibility="Collapsed" />
                                </Canvas>
                                <!-- CompareSlider のビフォー/アフター分割が画像上の
                                     どこに来るかを示す(スライダーだけでなく画像自体に)。
                                     位置(UpdateCompareSplitLine)は PreviewImage と同じ
                                     座標系の Margin.Left。PreviewBorder が画像に一致する
                                     サイズなのでスケール変換は不要。 -->
                                <Border x:Name="CompareSplitLine" Width="2" Background="White" Opacity="0.85"
                                        HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Collapsed" />
                                <!-- Shift 押下中またはアバター配置モード中、アバターの
                                     現在の配置矩形をなぞる(UpdateAvatarPlacementHighlight)。
                                     位置/サイズは上の CompareSplitLine と同じ座標系
                                     (PreviewBorder スケール、切り抜き考慮)。RotateTransform が
                                     アバターの回転に一致するので回転した配置をなぞる。
                                     IsHitTestVisible="False": 純粋な視覚的なぞりで、
                                     本体ドラッグは下の PreviewImage が担う。 -->
                                <Border x:Name="AvatarPlacementHighlight" BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="2" Background="#334A58C4"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="AvatarPlacementHighlightRotate" />
                                    </Border.RenderTransform>
                                </Border>
                                <!-- 四隅リサイズハンドル(アス比固定、回転対応)+ 回転ギズモ。
                                     アバター配置モード中のみ表示。レイヤー全体を
                                     (Canvas.Left/Top + Width/Height + RotateTransform で)
                                     AvatarPlacementHighlight の箱に一致させ、各子はレイヤー内の
                                     固定ローカル(未回転)オフセットで置く。OverlayWindow の
                                     HandlesLayer/PlaceHandle と同じ手法。 -->
                                <Canvas x:Name="AvatarHandlesLayer" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Canvas.RenderTransform>
                                        <RotateTransform x:Name="AvatarHandlesRotateTransform" />
                                    </Canvas.RenderTransform>
                                    <Rectangle x:Name="AvatarHandleTL" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNWSE" Tag="TopLeft"
                                               MouseLeftButtonDown="AvatarHandle_MouseLeftButtonDown" MouseMove="AvatarHandle_MouseMove" MouseLeftButtonUp="AvatarHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="AvatarHandleTR" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNESW" Tag="TopRight"
                                               MouseLeftButtonDown="AvatarHandle_MouseLeftButtonDown" MouseMove="AvatarHandle_MouseMove" MouseLeftButtonUp="AvatarHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="AvatarHandleBL" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNESW" Tag="BottomLeft"
                                               MouseLeftButtonDown="AvatarHandle_MouseLeftButtonDown" MouseMove="AvatarHandle_MouseMove" MouseLeftButtonUp="AvatarHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="AvatarHandleBR" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNWSE" Tag="BottomRight"
                                               MouseLeftButtonDown="AvatarHandle_MouseLeftButtonDown" MouseMove="AvatarHandle_MouseMove" MouseLeftButtonUp="AvatarHandle_MouseLeftButtonUp" />
                                    <!-- 引き出し線 + ハンドルを箱の上端中央の上にオフセット
                                         (中心ちょうどには置かない): 中心ちょうどのハンドルは
                                         掴んだ瞬間に角度を測る方向が定義できない。 -->
                                    <Line x:Name="AvatarRotateGizmoLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" IsHitTestVisible="False" />
                                    <Ellipse x:Name="AvatarRotateGizmoHandle" Width="16" Height="16" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                             Cursor="Hand"
                                             MouseLeftButtonDown="AvatarRotateGizmo_MouseLeftButtonDown" MouseMove="AvatarRotateGizmo_MouseMove" MouseLeftButtonUp="AvatarRotateGizmo_MouseLeftButtonUp" />
                                </Canvas>
                                <!-- デカール配置中の枠+角ハンドル+回転ギズモ。アバター用と
                                     同じくRenderTransformOrigin=0.5,0.5のRotateTransformを
                                     枠自体とハンドル層に掛け、各ハンドルはローカル(未回転)
                                     オフセットのまま置く(UpdateDecalHandles)。Margin/
                                     Width/Heightはコード側でその都度_placingDecalの位置に
                                     合わせて設定する。 -->
                                <Border x:Name="DecalPlacementHighlight" BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="2" Background="#334A58C4"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="DecalPlacementHighlightRotate" />
                                    </Border.RenderTransform>
                                </Border>
                                <Canvas x:Name="DecalHandlesLayer" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Canvas.RenderTransform>
                                        <RotateTransform x:Name="DecalHandlesRotateTransform" />
                                    </Canvas.RenderTransform>
                                    <Rectangle x:Name="DecalHandleTL" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNWSE" Tag="TopLeft"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleTR" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNESW" Tag="TopRight"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleBL" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNESW" Tag="BottomLeft"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleBR" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNWSE" Tag="BottomRight"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <!-- 辺ハンドル(枠線デカールのみ表示・UpdateDecalHandles)。
                                         角=アス比固定、辺=その軸だけ変更。 -->
                                    <Rectangle x:Name="DecalHandleT" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNS" Tag="Top" Visibility="Collapsed"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleB" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeNS" Tag="Bottom" Visibility="Collapsed"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleL" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeWE" Tag="Left" Visibility="Collapsed"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Rectangle x:Name="DecalHandleR" Width="10" Height="10" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                               Cursor="SizeWE" Tag="Right" Visibility="Collapsed"
                                               MouseLeftButtonDown="DecalHandle_MouseLeftButtonDown" MouseMove="DecalHandle_MouseMove" MouseLeftButtonUp="DecalHandle_MouseLeftButtonUp" />
                                    <Line x:Name="DecalRotateGizmoLine" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" IsHitTestVisible="False" />
                                    <Ellipse x:Name="DecalRotateGizmoHandle" Width="16" Height="16" Fill="White" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                             Cursor="Hand"
                                             MouseLeftButtonDown="DecalRotateGizmo_MouseLeftButtonDown" MouseMove="DecalRotateGizmo_MouseMove" MouseLeftButtonUp="DecalRotateGizmo_MouseLeftButtonUp" />
                                </Canvas>
                                <!-- Dims the part of the photo the current 切り抜き
                                     crop would throw away, while 切り抜き幅/位置X/Y
                                     is actively being dragged (see UpdateCanvasCropBoundary
                                     and _isCropAdjusting). PreviewImage.Source itself
                                     switches to the UNCROPPED composite for the same
                                     duration, so this shows the standard crop-tool
                                     "keep vs. discard" view instead of the always-
                                     already-cropped result the preview shows otherwise. -->
                                <Path x:Name="CanvasCropDimOverlay" Fill="#99000000"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False" Visibility="Collapsed" />
                                <!-- Background="Transparent"(null ではない)にして、
                                     2px の枠線だけでなく矩形全体が本体ドラッグの
                                     ヒットテスト対象になるようにする。IsHitTestVisible は
                                     常に True(Collapsed 中は無害)。 -->
                                <Border x:Name="CanvasCropBoundaryOutline" BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="2" Background="Transparent" Cursor="SizeAll"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="Collapsed"
                                        MouseLeftButtonDown="CanvasCropBoundary_MouseLeftButtonDown"
                                        MouseMove="CanvasCropBoundary_MouseMove"
                                        MouseLeftButtonUp="CanvasCropBoundary_MouseLeftButtonUp" />
                                <!-- 隅リサイズハンドル: CanvasCropBoundaryOutline と一緒に
                                     表示/配置される(UpdateCanvasCropBoundary)。各隅が
                                     どの隅かを Tag に持ち、共通ハンドラで使う。ドラッグすると
                                     対角の隅をアンカーに切り抜き箱をリサイズする
                                     (アス比固定、GetCanvasCropRect)。 -->
                                <Border x:Name="CanvasCropHandleTopLeft" Tag="TopLeft" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource PrimaryBrush}" BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Visibility="Collapsed"
                                        MouseLeftButtonDown="CanvasCropHandle_MouseLeftButtonDown"
                                        MouseMove="CanvasCropHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasCropHandle_MouseLeftButtonUp" />
                                <Border x:Name="CanvasCropHandleTopRight" Tag="TopRight" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource PrimaryBrush}" BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNESW" Visibility="Collapsed"
                                        MouseLeftButtonDown="CanvasCropHandle_MouseLeftButtonDown"
                                        MouseMove="CanvasCropHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasCropHandle_MouseLeftButtonUp" />
                                <Border x:Name="CanvasCropHandleBottomLeft" Tag="BottomLeft" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource PrimaryBrush}" BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNESW" Visibility="Collapsed"
                                        MouseLeftButtonDown="CanvasCropHandle_MouseLeftButtonDown"
                                        MouseMove="CanvasCropHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasCropHandle_MouseLeftButtonUp" />
                                <Border x:Name="CanvasCropHandleBottomRight" Tag="BottomRight" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource PrimaryBrush}" BorderBrush="White" BorderThickness="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Visibility="Collapsed"
                                        MouseLeftButtonDown="CanvasCropHandle_MouseLeftButtonDown"
                                        MouseMove="CanvasCropHandle_MouseMove"
                                        MouseLeftButtonUp="CanvasCropHandle_MouseLeftButtonUp" />
                            </Grid>

                            <!-- ShowComposite または Match ボタンが遅いフル解像度
                                 計算を遅延している間だけ表示。スピナー回転は
                                 CompositeLoadingSpinStoryboard(Window.Resources)で、
                                 Visibility を直接いじらず ShowCompositeLoading/
                                 HideCompositeLoading から開始/停止する。 -->
                            <StackPanel x:Name="CompositeLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Viewbox Width="28" Height="28" Margin="0,0,0,10">
                                    <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="CompositeLoadingSpinnerRotate" />
                                        </Canvas.RenderTransform>
                                        <!-- 270 度の弧(全円だと静的なリングに見える)。
                                             他アイコンと同じ細ストロークのベクター見た目。 -->
                                        <Path Data="M 12,3 A 9,9 0 1 1 3,12" Stroke="{DynamicResource PrimaryBrush}"
                                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="CompositeLoadingText" Text="読み込み中…" FontSize="16"
                                           Foreground="White" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Undo/Redo の一瞬の反応: フェードイン→アウトする小さな
                                 アイコンをプレビュー画像の中央に重ねる
                                 (ShowUndoRedoReaction/UndoManager.Applied)。
                                 IsHitTestVisible="False" で下のプレビュー操作を妨げない。 -->
                            <Border x:Name="UndoRedoReactionBadge" Width="34" Height="34"
                                    Background="{DynamicResource PrimaryBrush}" CornerRadius="17"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                                <Viewbox Width="16" Height="16">
                                    <Grid>
                                        <!-- Lucide "undo-2" アイコン(ISC ライセンス)。 -->
                                        <Canvas x:Name="UndoReactionIcon" Width="24" Height="24">
                                            <Path Data="M9 14 4 9l5-5" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path Data="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <!-- Lucide "redo-2" アイコン(ISC ライセンス)。 -->
                                        <Canvas x:Name="RedoReactionIcon" Width="24" Height="24" Visibility="Collapsed">
                                            <Path Data="m15 14 5-5-5-5" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path Data="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13" Stroke="White" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 確定/キャンセル bar for 切り抜きモード/アバター配置モード: a
                         sibling of PreviewBorder within PreviewHost itself (not
                         inside PreviewBorder, which is sized/positioned to match
                         just the IMAGE; letterboxed narrower than PreviewHost
                         for a portrait photo, say), so this pins to the bottom
                         of the whole PREVIEW PANE instead, just above where the
                         比較用スライダー row starts right below PreviewHost.
                         Shown/hidden alongside RefreshSliderLockState's own
                         locked check (see CropModeToggle_Changed/
                         AvatarPlacementModeToggle_Changed, the same two modes
                         that gray out the slider column); 確定 just turns the
                         active mode's toggle off, keeping whatever's currently
                         set; キャンセル restores the snapshot captured the
                         moment that mode was turned on, then turns it off too;
                         see PreviewModeConfirmButton_Click/
                         PreviewModeCancelButton_Click. -->
                    <StackPanel x:Name="PreviewModeConfirmBar" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                Visibility="Collapsed">
                        <Button Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="PreviewModeConfirmButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20 6 9 17l-5-5" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="確定" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryPillButton}" Click="PreviewModeCancelButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M18 6 6 18" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="m6 6 12 12" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="キャンセル" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 配置: floats on top of the preview instead of sitting
                         in the controls column, since adjusting where the
                         avatar sits is naturally done while looking at the
                         image itself. Collapsible (chevron button) so it can
                         be tucked away once placement is set and it's just
                         obstructing the shot. Anchored to a fixed corner
                         (top-left) rather than being draggable, to keep this
                         simple. See PlacementCollapseButton_Click. -->
                    <Border x:Name="PlacementPanel" Style="{StaticResource Card}" Padding="12" Width="260"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="配置" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="PlacementCollapseButton" Style="{StaticResource BackButton}"
                                        Padding="6,2" Click="PlacementCollapseButton_Click">
                                    <!-- Lucide "chevron-down"/"chevron-up" アイコン(ISC ライセンス):
                                         Data はコードビハインドで両者を切り替える
                                         (PlacementCollapseButton_Click)。 -->
                                    <Viewbox Width="11" Height="11">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="PlacementCollapseIcon" Data="m6 9 6 6 6-6"
                                                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="PlacementPanelBody" Margin="0,8,0,0">
                                <!-- キャンバス比率: crops the FINISHED composite down to
                                     the chosen aspect ratio as the very last step (after
                                     every color/finishing effect), centered by default and
                                     adjustable via 切り抜きモード (see CropModeToggle below)
                                     when the original photo's own ratio doesn't leave the
                                     crop centered where it should be. 自由 (null ratio, still
                                     Tag="original" internally) doesn't lock a ratio, but IS
                                     still an active crop: width and height each shrink
                                     independently instead of together; see
                                     GetCanvasCropRect/GetMaxCropSize. -->
                                <!-- Its own 100%/100% default (both crop knobs start full-
                                     size) means a freshly-selected 自由 looks identical to
                                     "no crop" until the user actually drags something,
                                     matching what 元 used to look like without needing a
                                     separate "cropping is entirely off" state at all. -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="キャンバス比率" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="仕上がりの縦横比を選び、写真をその比率に切り抜きます" />
                                    <ComboBox Grid.Column="1" x:Name="CanvasAspectCombo" Style="{StaticResource CompactComboBox}"
                                              HorizontalAlignment="Left" MinWidth="90" Margin="8,0,0,0"
                                              ToolTip="仕上がりの縦横比を選び、写真をその比率に切り抜きます" SelectionChanged="CanvasAspectCombo_SelectionChanged">
                                        <ComboBoxItem Content="自由" Tag="original" ToolTip="アス比を固定せず、幅と高さを個別に切り抜きます" />
                                        <ComboBoxItem Content="1:1" Tag="1" />
                                        <ComboBoxItem Content="4:5" Tag="0.8" />
                                        <ComboBoxItem Content="9:16" Tag="0.5625" />
                                        <ComboBoxItem Content="16:9" Tag="1.7778" />
                                        <ComboBoxItem Content="カスタム" Tag="custom" />
                                    </ComboBox>
                                </Grid>
                                <!-- Only shown while "カスタム" is selected, as its own
                                     row below the combo (not crammed into that row) so
                                     there's room for two separate 横/縦 fields instead of
                                     one pre-divided decimal. _canvasAspectRatio IS still
                                     just a single width/height double underneath (matching
                                     every preset above; "4:5" is just 0.8's own display
                                     label); these two boxes are purely a friendlier INPUT
                                     for that same value, not separate persisted state, so
                                     RefreshCanvasAspectUI re-derives their text from
                                     _canvasAspectRatio directly (as ratio:1) whenever it
                                     doesn't already match one of the five presets, same as
                                     the old single box did. -->
                                <Grid x:Name="CanvasAspectCustomRow" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="縦横比" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="仕上がりの縦横比を横:縦の数値で入力します (例: 16:9)" />
                                    <TextBox Grid.Column="1" x:Name="CanvasAspectCustomWidthBox" Style="{StaticResource SliderRowBox}"
                                             Margin="8,0,0,0" ToolTip="横の比率"
                                             TextChanged="CanvasAspectCustomRatio_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="3" x:Name="CanvasAspectCustomHeightBox" Style="{StaticResource SliderRowBox}"
                                             ToolTip="縦の比率"
                                             TextChanged="CanvasAspectCustomRatio_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- 背景写真そのものを90°ずつ回転(幅と高さが入れ替わる)。
                                     縦横を間違えて撮ったスクリーンショットの向きを直す用途。
                                     アバターの回転(_compositeRotationのフリー角度)とは別物。
                                     回すとアバター配置・デカール位置は新しい写真の向きに
                                     合わせて初期化し直される(RotatePhotoButton_Click)。 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="写真の向き" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="背景写真を90°ずつ回転します" />
                                    <Button Grid.Column="2" x:Name="RotatePhotoButton" Style="{StaticResource RotateIconButton}"
                                            Click="RotatePhotoButton_Click" ToolTip="背景写真を90°回転します">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                <Path Data="M21 3v5h-5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <!-- Persistent alternative to dragging 切り抜き幅/位置X/Y:
                                     while on, the crop boundary (dim+outline+corner
                                     handles) stays visible on the preview and can be
                                     dragged directly there instead; see
                                     CropModeToggle_Changed/UpdateCanvasCropBoundary/
                                     CanvasCropHandle_*/CanvasCropBoundary_*. -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="CropModeLabel" Text="切り抜きモード" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="プレビュー上で切り抜き範囲を直接ドラッグして調整します" />
                                    <ToggleButton Grid.Column="1" x:Name="CropModeToggle" Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Left" Margin="8,0,0,0"
                                                  Checked="CropModeToggle_Changed" Unchecked="CropModeToggle_Changed"
                                                  ToolTip="プレビュー上で切り抜き範囲を直接ドラッグして調整します" />
                                </Grid>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                                <!-- Grayed out (IsEnabled=False, see CropModeToggle_Changed)
                                     while 切り抜きモード is on: editing avatar placement at the
                                     same time as dragging the crop boundary is confusing (the
                                     preview shows the full uncropped photo during crop mode,
                                     not where the avatar will actually end up relative to the
                                     final crop), so this whole group is disabled instead of
                                     left interactive but misleading. -->
                                <StackPanel x:Name="CompositePlacementControlsPanel">
                                <!-- Persistent alternative to Shift+drag (still works as a
                                     quick shortcut even with this off): while on, the avatar's
                                     bounding box + 4 corner resize handles (aspect ratio
                                     locked) + a rotate gizmo stay up on the preview; see
                                     AvatarPlacementModeToggle_Changed/UpdateAvatarPlacementHighlight/
                                     AvatarHandle_*/AvatarRotateGizmo_*. Mutually exclusive with
                                     切り抜きモード (turning one on turns the other off): both
                                     want the preview's own drag gestures to themselves. -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarPlacementModeLabel" Text="アバター配置モード" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="プレビュー上でアバター画像の位置・サイズ・回転を直接ドラッグして編集します" />
                                    <ToggleButton Grid.Column="1" x:Name="AvatarPlacementModeToggle" Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Left" Margin="8,0,0,0"
                                                  Checked="AvatarPlacementModeToggle_Changed" Unchecked="AvatarPlacementModeToggle_Changed"
                                                  ToolTip="プレビュー上でアバター画像の位置・サイズ・回転を直接ドラッグして編集します" />
                                </Grid>
                                <Button Style="{StaticResource SecondaryPillButton}"
                                        HorizontalAlignment="Left" Click="ResetCompositePlacementButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                                                <TextBlock Text="リセット" />
                                            </StackPanel>
                                </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ドロップガイド: レタッチモードで画像をドラッグしている間だけ表示。
                         ドロップ位置で読み込み先を選ぶ ── 上部左=アバター画像 /
                         上部右=背景画像 / 下部=合成せず1枚でレタッチ。位置判定と
                         ゾーンのハイライトは DropGuide_DragOver / DropGuide_Drop。 -->
                    <Grid x:Name="DropGuideOverlay" AllowDrop="True" Visibility="Collapsed" Background="#B4101018"
                          DragOver="DropGuide_DragOver" DragLeave="DropGuide_DragLeave" Drop="DropGuide_Drop">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="1.3*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DropZoneAvatar" Grid.Row="0" Grid.Column="0" Margin="6"
                                    CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource HairlineBrush}"
                                    Background="#1FFFFFFF">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="30" Height="30">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="8" Canvas.Top="3" Width="8" Height="8" Stroke="White" StrokeThickness="2" />
                                            <Path Data="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="アバター画像" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,8,0,2" />
                                    <TextBlock Text="写真の上に合成する画像" Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="DropZoneBackground" Grid.Row="0" Grid.Column="1" Margin="6"
                                    CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource HairlineBrush}"
                                    Background="#1FFFFFFF">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="30" Height="30">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2"
                                                       Stroke="White" StrokeThickness="2" />
                                            <Ellipse Canvas.Left="7" Canvas.Top="7" Width="3.5" Height="3.5" Stroke="White" StrokeThickness="2" />
                                            <Path Data="m21 15-4.5-4.5L6 21" Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="背景画像" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,8,0,2" />
                                    <TextBlock Text="アバターの背景になる画像" Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="DropZoneSingle" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="6"
                                    CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource HairlineBrush}"
                                    Background="#1FFFFFFF">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="28" Height="28">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3" Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" />
                                            <Path Data="M2 14h4M10 12h4M18 16h4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="合成せず1枚でレタッチ" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,6,0,2" />
                                    <TextBlock Text="ドロップした画像を1枚だけ色調補正・トリミング" Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </Grid>

                    <!-- ビフォー/アフター比較: 上のプレビューと同じ幅。0(既定/左端)では
                         通常のフル調整済み合成を表示し、右へドラッグすると縦の分割線が
                         画像を横切り、左から「ルック調整も仕上げ効果も無し」の同じ配置が
                         現れる。RenderCompositePreview/UpdateComparisonPreview 参照。 -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Panel.ZIndex="10">
                        <!-- ZIndex=10: CompareSlider は置かれた列よりわざと広いので、
                             Value 0/100 で丸 thumb が列の端を数 px はみ出す。ZIndex を
                             上げないと、そのはみ出しが右のスプリッタ/カード列の背面に
                             描かれて thumb が切れて見える。 -->
                        <!-- ラベルとは別の中央寄せ StackPanel にして、ラベル幅で
                             スライダーが上の画像から中心ズレしないようにする。幅は
                             コード(SizePreviewToImage)で画像の表示幅 + thumb 直径に
                             設定する。縦長写真では Stretch="Uniform" が画像を列より
                             細くレターボックスするので、スライダーは横の余白ではなく
                             画像に追従すべき。 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Slider x:Name="CompareSlider" Minimum="0" Maximum="100" Value="0" Tag="NoFill"
                                    VerticalAlignment="Center" ValueChanged="CompareSlider_ValueChanged" />
                        </StackPanel>
                        <!-- Value=0(左)ではフル調整済み合成、右へドラッグすると
                             未調整版が左から現れる。MergeBeforeAfter 参照。 -->
                        <TextBlock Text="比較用スライダー" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <!-- 1行目: 分割保存。なし = 通常保存。2〜4 = キャンバス(切り抜き
                             範囲)を横に均等分割してその枚数だけ保存(プレビューに区切り線)。
                             「分割時の余白」は各継ぎ目で左右あわせてその px 分だけ内容を
                             落とす(= 隣り合う画像の間に空きができる)。ファイル名は
                             <選んだ名前>_1.png .. _N.png。 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="分割" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.7" />
                            <RadioButton x:Name="Split1" GroupName="SplitCount" Content="なし" Tag="1" IsChecked="True"
                                         Style="{StaticResource AspectRatioRadioButton}" Checked="SplitCountRadio_Checked"
                                         ToolTip="通常保存(分割なし)" />
                            <RadioButton x:Name="Split2" GroupName="SplitCount" Content="2" Tag="2"
                                         Style="{StaticResource AspectRatioRadioButton}" Checked="SplitCountRadio_Checked" />
                            <RadioButton x:Name="Split3" GroupName="SplitCount" Content="3" Tag="3"
                                         Style="{StaticResource AspectRatioRadioButton}" Checked="SplitCountRadio_Checked" />
                            <RadioButton x:Name="Split4" GroupName="SplitCount" Content="4" Tag="4"
                                         Style="{StaticResource AspectRatioRadioButton}" Checked="SplitCountRadio_Checked" />
                            <Border Width="10" />
                            <TextBlock x:Name="SplitGapLabel" Text="分割時の余白" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                       VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                            <TextBox x:Name="SplitGapBox" Style="{StaticResource SliderRowBox}" Text="12"
                                     Margin="4,0,0,0" TextAlignment="Center"
                                     ToolTip="分割の各継ぎ目に入れる余白(px)。隣り合う画像の間の空き"
                                     TextChanged="SplitGapBox_TextChanged" />
                            <TextBlock x:Name="SplitGapUnit" Text="px" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                       VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.7" />
                        </StackPanel>
                        <!-- 2行目: 保存ボタン + 結果ステータス + フォルダを開く -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SaveCompositeButton" Style="{StaticResource PillButton}"
                                    Click="SaveCompositeButton_Click" IsEnabled="False" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
                                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path Data="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"
                                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path Data="M7 3v4a1 1 0 0 0 1 1h7"
                                                  Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="この合成結果を保存" />
                                </StackPanel>
                            </Button>
                            <!-- Lucide "check" アイコン(ISC ライセンス)。保存成功時にフェードイン。 -->
                            <Viewbox x:Name="CompositeSaveCheckmark" Width="13" Height="13" VerticalAlignment="Center"
                                     Margin="0,0,4,0" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20 6 9 17l-5-5" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CompositeSaveStatusText" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <!-- 保存成功時だけ表示。エクスプローラーで保存先を選択表示する。 -->
                            <Button x:Name="OpenSavedFolderButton" Style="{StaticResource SecondaryPillButton}"
                                    FontSize="12" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="OpenSavedFolderButton_Click"
                                    ToolTip="保存先をエクスプローラーで開く">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="12" Height="12" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"
                                                  Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="フォルダを開く" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- コントロール: 左右2列(アバター画像 / 背景写真)。各列にローダー
                     カードと配置/ルックカードを積む。ウィンドウより高ければスクロールする。
                     CompositePanel の両行にまたがる(RowSpan="2")ので上端がホーム/
                     最小化ボタンの行にそろう(ナビ行はプレビュー列しか占めない)。 -->
                <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource PreviewCardsSplitter}" />

                <ScrollViewer x:Name="CompositeCardsScrollViewer" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,14,16,14" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 両列は独立して積むのではなく共有行(ローダー / ルック / 3枚目)を
                         使うので、行ごとにそろえたいルックカードのスライダーが、
                         2つのローダーカードの高さに関わらず同じ高さから始まる。 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="アバター画像" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="CompositeLoadImageButton" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="LoadImageButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ContentPresenter Content="{StaticResource ImageIcon}" />
                                            <TextBlock Text="アバター画像を読み込む" />
                                        </StackPanel>
                            </Button>
                            <TextBlock x:Name="CompositeImagePathText" Text="(アバター画像未読み込み)" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6" />
                            <StackPanel x:Name="CompositeRecentAvatarsPanel" Orientation="Horizontal" Margin="0,0,0,8"
                                        SizeChanged="CompositeRecentAvatarsPanel_SizeChanged" />
                            <!-- 背景写真側の「背景なしで作成」ボタンと見た目を
                                 揃えたアイコン+テキストのピル型ボタン。一度きりの
                                 操作(押すと無効化されたままになる)なので
                                 SecondaryPillButtonDimmableでIsEnabled=False時に
                                 ちゃんと薄くなるようにしてある(元のSkipAvatarButton
                                 にはあった挙動)。テキストは押した後
                                 「アバターなしで進行中」に変わる(RefreshSkipAvatarUI、
                                 Contentではなく子のTextBlockを直接更新)。 -->
                            <Button x:Name="CompositeSkipAvatarButton" Style="{StaticResource SecondaryPillButtonDimmable}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="CompositeSkipAvatarButton_Click"
                                    ToolTip="アバター画像を使わず、背景写真だけを編集して保存します">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="2" />
                                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Stroke="White" StrokeThickness="2" />
                                                    <Path Data="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M2 2 22 22" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="CompositeSkipAvatarButtonText" Text="アバターなしにする" />
                                        </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- アバター画像のルック(位置/サイズ/回転は位置合わせモード側、
                         同じ state を共有)。スライダー順は隣の写真ルックカードに合わせて
                         行ごとにそろえる。境界ぼかし は写真側に対応が無いので、そろえを
                         崩さず下に分けて置く。 -->
                    <Border x:Name="AvatarLookCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource DimmableCard}" Padding="12" Margin="0,0,0,8">
                        <!-- StackPanel ではなく Grid にして、リセットボタンをこの
                             Border の下端に固定する。2つのルックカードは1つの Grid 行を
                             共有するので、内容の少ない列は兄弟に引き伸ばされ、
                             StackPanel 積みのボタンの下に空白ができてしまう。

                             IsEnabled は RefreshSkipAvatarUI から切り替える:
                             _compositeSkipAvatar オン中はグレーアウト(アバター無しでは
                             調整対象が無い)。 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="アバター画像の見た目" Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center" />
                                <!-- このカードと写真ルックカードの両方を制御するが、
                                     両者の上に浮かせず、このヘッダー横の空きに置く。 -->
                                <ToggleButton Grid.Column="1" x:Name="LookLinkToggle" Style="{StaticResource LinkToggleButton}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="LookLinkToggle_Changed" Unchecked="LookLinkToggle_Changed" />
                            </Grid>

                                <!-- 上の11スライダーを背景写真の現在のルックへ寄せる
                                     (MatchAvatarToPhotoButton_Click): 統計ベースの一致
                                     (輝度/彩度/色相/ホワイトバランスの平均・標準偏差)で
                                     AI 処理ではないため即座に完全オフラインで動く。
                                     Lucide "blend" アイコン(ISC ライセンス)。 -->
                                <Button x:Name="MatchAvatarToPhotoButton" Style="{StaticResource SecondaryPillButton}"
                                        HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,10" IsEnabled="False"
                                        Click="MatchAvatarToPhotoButton_Click" ToolTip="アバター画像の見た目を背景写真の現在の見た目に近づけます">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="背景に近づける" />
                                    </StackPanel>
                                </Button>

                                <Grid x:Name="AvatarBrightnessRow" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarBrightnessLabel" Text="明るさ" Style="{StaticResource SliderRowLabel}" ToolTip="画像全体の明るさ" />
                                    <Slider Grid.Column="1" x:Name="CompositeBrightnessSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="BrightnessSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeBrightnessBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="BrightnessBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarContrastLabel" Text="コントラスト" Style="{StaticResource SliderRowLabel}" ToolTip="明暗の差の強さ" />
                                    <Slider Grid.Column="1" x:Name="CompositeContrastSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="ContrastSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeContrastBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="ContrastBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarSaturationLabel" Text="彩度" Style="{StaticResource SliderRowLabel}" ToolTip="色の鮮やかさ全体" />
                                    <Slider Grid.Column="1" x:Name="CompositeSaturationSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="SaturationSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeSaturationBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="SaturationBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarVibranceLabel" Text="自然な彩度" Style="{StaticResource SliderRowLabel}" ToolTip="彩度に近い効果ですが、すでに鮮やかな色は抑えめにして肌色などを保護します" />
                                    <Slider Grid.Column="1" x:Name="CompositeVibranceSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="VibranceSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeVibranceBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="VibranceBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarTemperatureLabel" Text="色温度" Style="{StaticResource SliderRowLabel}" ToolTip="画像を暖色(オレンジ)寄りか寒色(青)寄りにします" />
                                    <Slider Grid.Column="1" x:Name="CompositeTemperatureSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="TemperatureSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeTemperatureBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="TemperatureBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarTintLabel" Text="色合い" Style="{StaticResource SliderRowLabel}" ToolTip="画像を緑寄りかマゼンタ(赤紫)寄りにします" />
                                    <Slider Grid.Column="1" x:Name="CompositeTintSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="TintSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeTintBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="TintBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarHueLabel" Text="色相" Style="{StaticResource SliderRowLabel}" ToolTip="色全体を色相環上でずらします" />
                                    <Slider Grid.Column="1" x:Name="CompositeHueSlider" Minimum="-180" Maximum="180" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="HueSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeHueBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="HueBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarHighlightsLabel" Text="ハイライト" Style="{StaticResource SliderRowLabel}" ToolTip="明るい部分の明るさだけを調整します" />
                                    <Slider Grid.Column="1" x:Name="CompositeHighlightsSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="HighlightsSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeHighlightsBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="HighlightsBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarShadowsLabel" Text="シャドウ" Style="{StaticResource SliderRowLabel}" ToolTip="暗い部分の明るさだけを調整します" />
                                    <Slider Grid.Column="1" x:Name="CompositeShadowsSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="ShadowsSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeShadowsBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="ShadowsBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarWhitesLabel" Text="白レベル" Style="{StaticResource SliderRowLabel}" ToolTip="最も明るい白の締まり具合を調整します" />
                                    <Slider Grid.Column="1" x:Name="CompositeWhitesSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="WhitesSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeWhitesBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="WhitesBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarBlacksLabel" Text="黒レベル" Style="{StaticResource SliderRowLabel}" ToolTip="最も暗い黒の締まり具合を調整します" />
                                    <Slider Grid.Column="1" x:Name="CompositeBlacksSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="BlacksSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeBlacksBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="BlacksBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- ティント: an overall color wash toward a
                                     chosen color, luminance-preserving (see
                                     ImageAdjustment.AdjustColors' ColorTint
                                     block) rather than a flat RGB blend, so
                                     detail stays visible even at strength 100
                                     instead of flattening to one solid color.
                                     Distinct from the existing 色温度/ティント
                                     (Temperature/Tint) axis sliders above,
                                     which only nudge warm/cool and green/
                                     magenta: this picks ANY color via the
                                     same wheel popup DropShadow/LightLeak use. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AvatarColorTintLabel" Text="ティント色" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="指定した色を強度に応じて重ねます(色相/色温度とは別の色被せ効果)" />
                                    <Button Grid.Column="1" x:Name="CompositeColorTintButton" Style="{StaticResource ColorSwatchBarButton}"
                                            Click="CompositeColorTintButton_Click" ToolTip="ティントの色を選択">
                                        <Border x:Name="CompositeColorTintSwatch" CornerRadius="5"
                                                Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="CompositeColorTintEyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="CompositeColorTintEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="CompositeColorTintHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="CompositeColorTintHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <Popup x:Name="CompositeColorTintPopup" PlacementTarget="{Binding ElementName=CompositeColorTintButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="ティント色" Style="{StaticResource SectionHeader}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                    <Image x:Name="CompositeColorTintWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                           MouseLeftButtonDown="CompositeColorTintWheel_MouseDown"
                                                           MouseMove="CompositeColorTintWheel_MouseMove"
                                                           MouseLeftButtonUp="CompositeColorTintWheel_MouseUp" />
                                                    <Border x:Name="CompositeColorTintWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                            BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                </Grid>
                                                            <Slider x:Name="CompositeColorTintValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    ValueChanged="CompositeColorTintValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="CompositeColorTintRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="CompositeColorTintRSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="CompositeColorTintRBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="CompositeColorTintRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="CompositeColorTintGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="CompositeColorTintGSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="CompositeColorTintGBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="CompositeColorTintGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="CompositeColorTintBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="CompositeColorTintBSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="CompositeColorTintBBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="CompositeColorTintBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Border x:Name="CompositeColorTintPreviewLarge" Height="28" CornerRadius="6"
                                                        Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- 上のラベル行と共有せず専用行(他の通常スライダー行と
                                     同じ3列レイアウト)にして、このスライダーの長さを
                                     他とそろえる。ラベル+色ボタン行に並べると Auto 列2つが
                                     Width="*" を食って明らかに短くなっていた。 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SliderRowLabel}" />
                                    <Slider Grid.Column="1" x:Name="CompositeColorTintStrengthSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="CompositeColorTintStrengthSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PngColorSliderMouseDown" PreviewMouseLeftButtonUp="PngColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeColorTintStrengthBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="CompositeColorTintStrengthBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- 境界ぼかし is its own group, separate from
                                     the 一括調整-linked rows above (it has no
                                     photo-side counterpart, so it's never part
                                     of the link). The divider marks that
                                     boundary, and matches where the connector
                                     bar on the right stops. -->
                                <Border x:Name="AvatarLookDivider" Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,2,0,12" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="境界ぼかし" Style="{StaticResource SliderRowLabel}" ToolTip="画像の輪郭をぼかして背景になじませます" />
                                    <Slider Grid.Column="1" x:Name="CompositeEdgeBlurSlider" Minimum="0" Maximum="30" VerticalAlignment="Center"
                                            ValueChanged="EdgeBlurSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="EdgeBlurSliderMouseDown" PreviewMouseLeftButtonUp="EdgeBlurSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="CompositeEdgeBlurBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="EdgeBlurBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>

                                <!-- ドロップシャドウ: duplicates the avatar's own
                                     silhouette, offset in a direction and
                                     blurred/tinted (multiply blend); see
                                     ImageAdjustment.ApplyDropShadow. Only has any
                                     effect with an avatar loaded. Moved here (below
                                     境界ぼかし, still in the avatar-look card) from
                                     仕上げエフェクト at the user's request. -->
                                <!-- Title-only row (no control of its own): every actual
                                     setting below, including the color/direction/blend-mode
                                     controls that used to share this row, is now its own
                                     "・"-prefixed label|control|value row so the whole effect
                                     follows the exact same 3-column grammar as a plain slider
                                     row (ソフトネス/シャープネス/etc.) instead of mixing a
                                     wide multi-column header with indented sub-rows. Still
                                     wrapped in the same 3-column Grid as every other row
                                     (not a bare TextBlock) so its label sits in the exact
                                     same Column0 as 境界ぼかし above it, instead of relying
                                     on a loose TextBlock happening to render at the same X. -->
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ドロップシャドウ" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="アバター画像の影を複製し、向き・幅・ぼかし・色を指定して重ねます" />
                                </Grid>

                                <!-- ・色: a long horizontal swatch bar (matches a slider's own
                                     width) instead of a small square icon, with a hex code
                                     textbox in the value column, same slot a numeric TextBox
                                     occupies on every other row. -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・色" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影の色を選択" Opacity="0.7" />
                                    <Button Grid.Column="1" x:Name="DropShadowColorButton" Style="{StaticResource ColorSwatchBarButton}"
                                            Click="DropShadowColorButton_Click" ToolTip="影の色を選択">
                                        <Border x:Name="DropShadowColorSwatch" CornerRadius="5"
                                                Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <!-- スポイト: 押してからプレビュー画像上をクリックして
                                         そのピクセルの色を拾う(BeginColorPick/
                                         TryPickColorAtClick)。スウォッチバーと hex ボックスの
                                         間、専用の Auto 列。 -->
                                    <Button Grid.Column="2" x:Name="DropShadowEyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="DropShadowEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="DropShadowColorHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="DropShadowColorHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <!-- OS 標準の色ダイアログではなく AvaSnap 風の自前
                                         ポップアップ。StaysOpen="False" で外側クリックで閉じる
                                         (コンボボックスのドロップダウンと同じ)。 -->
                                    <Popup x:Name="DropShadowColorPopup" PlacementTarget="{Binding ElementName=DropShadowColorButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="影の色" Style="{StaticResource SectionHeader}" />

                                                <!-- カラーホイール: 角度=色相、中心からの距離=彩度。
                                                     DropShadowColorWheel.Source は一度だけ生成する
                                                     140x140 ビットマップ(GetColorWheelBitmap、明度=1
                                                     固定)。明度は下の別スライダーで、選んだ色相/
                                                     彩度の RGB を再スケールするだけ。 -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                    <Image x:Name="DropShadowColorWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                           MouseLeftButtonDown="DropShadowColorWheel_MouseDown"
                                                           MouseMove="DropShadowColorWheel_MouseMove"
                                                           MouseLeftButtonUp="DropShadowColorWheel_MouseUp" />
                                                    <Border x:Name="DropShadowColorWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                            BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                </Grid>
                                                            <Slider x:Name="DropShadowColorValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    ValueChanged="DropShadowColorValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="DropShadowColorRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="DropShadowColorRSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="DropShadowColorRBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="DropShadowColorRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="DropShadowColorGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="DropShadowColorGSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="DropShadowColorGBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="DropShadowColorGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="DropShadowColorBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="DropShadowColorBSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="DropShadowColorBBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="DropShadowColorBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Border x:Name="DropShadowColorPreviewLarge" Height="28" CornerRadius="6"
                                                        Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- ・合成方法: control column holds the combo box; the combo's
                                     own selected text already IS its value, so no separate value
                                     column content is needed here (like ・色 above). -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・合成方法" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影の色を写真にどう重ねるか" Opacity="0.7" />
                                    <ComboBox Grid.Column="1" x:Name="DropShadowBlendModeCombo" Style="{StaticResource CompactComboBox}"
                                              MinWidth="90"
                                              ToolTip="影の色を写真にどう重ねるか" SelectionChanged="DropShadowBlendModeCombo_SelectionChanged">
                                        <ComboBoxItem Content="乗算" Tag="multiply" ToolTip="下地を暗く/色付けする、通常の影らしい見た目" />
                                        <ComboBoxItem Content="通常" Tag="normal" ToolTip="下地を無視して影の色をそのまま重ねる" />
                                        <ComboBoxItem Content="加算" Tag="additive" ToolTip="下地に影の色の光を足す(発光風)" />
                                    </ComboBox>
                                </Grid>

                                <!-- ・強さ/幅/ぼかし: a "・" prefix marks them as ドロップシャドウの
                                     own sub-settings rather than independent top-level effects (a
                                     drawn tree-view connector line was tried and reverted: too
                                     fragile to align correctly without exact pixel heights). -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・強さ" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影の濃さ" Opacity="0.7" />
                                    <Slider Grid.Column="1" x:Name="DropShadowSlider" Margin="8,0,0,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="DropShadowSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="DropShadowBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="DropShadowBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- ・方向: control column holds the dial, value column holds
                                     the degree readout, same slot the numeric TextBox occupies
                                     on a slider row. -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・方向" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影の向き(度)" Opacity="0.7" />
                                    <Slider Grid.Column="1" x:Name="DropShadowDirectionSlider" Margin="8,0,0,0" Minimum="0" Maximum="360" VerticalAlignment="Center"
                                            ValueChanged="DropShadowDirectionSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="DropShadowDirectionBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="DropShadowDirectionBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・幅" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影を複製してずらす距離(ピクセル)" Opacity="0.7" />
                                    <Slider Grid.Column="1" x:Name="DropShadowDistanceSlider" Margin="8,0,0,0" Minimum="0" Maximum="300" VerticalAlignment="Center"
                                            ValueChanged="DropShadowDistanceSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="DropShadowDistanceBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="DropShadowDistanceBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="・ぼかし" Style="{StaticResource SliderRowLabel}" Width="116"
                                               ToolTip="影の輪郭のぼかし量" Opacity="0.7" />
                                    <Slider Grid.Column="1" x:Name="DropShadowBlurSlider" Margin="8,0,0,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="DropShadowBlurSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="DropShadowBlurBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="DropShadowBlurBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>

                            </StackPanel>
                            <Button Grid.Row="1" Style="{StaticResource SecondaryPillButton}"
                                    HorizontalAlignment="Left" Click="ResetLookButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                                            <TextBlock Text="リセット" />
                                        </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="背景写真" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="PickPhotoButton" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="PickPhotoButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ContentPresenter Content="{StaticResource ImageIcon}" />
                                            <TextBlock Text="背景写真を選ぶ" />
                                        </StackPanel>
                            </Button>
                            <TextBlock x:Name="PhotoPathText" Text="(背景写真未選択)" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6" />
                            <!-- コードで生成(RefreshRecentPhotosUI)。スクショ監視
                                 フォルダに実在する新しい PNG を、行幅に収まるぶんだけ
                                 新しい順に並べる。 -->
                            <StackPanel x:Name="RecentPhotosPanel" Orientation="Horizontal" Margin="0,0,0,8"
                                        SizeChanged="RecentPhotosPanel_SizeChanged" />
                            <!-- 実写真を使わず単色(またはグラデーション)で塗った
                                 合成用の写真を作る(CreateBlankCanvasButton_Click)。
                                 以降は通常の写真読み込みと全く同じパイプライン
                                 (クロップ/配置/デカール/仕上げエフェクト)を通るので、
                                 色/グラデーション/図形デカールだけでシェイプ背景を
                                 組み立てられる。押すたびに白(グラデーションoff)で
                                 作り直し、その下の色UIが現れる。色UI自体は常時
                                 表示ではなく「作成」した後にだけ意味を持つので、
                                 押すまではCollapsed。色UIの各項目はアバター画像側の
                                 ティント色(CompositeColorTintButton)と全く同じ構成
                                 (スウォッチ+色相環ポップアップ+スポイト+カラー
                                 コード)で、変更するたびに今の解像度のまま塗り直して
                                 即座にプレビューへ反映する(RegenerateBlankCanvas)。 -->
                            <Button x:Name="BlankCanvasButton" Style="{StaticResource SecondaryPillButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="CreateBlankCanvasButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" RadiusX="3" RadiusY="3" Fill="White" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="背景なしで作成" />
                                        </StackPanel>
                            </Button>
                            <StackPanel x:Name="BlankCanvasColorPanel" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="BlankCanvasColorLabel" Text="背景の色" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="背景の塗りつぶし色を選択" />
                                    <Button Grid.Column="1" x:Name="BlankCanvasColorButton" Style="{StaticResource ColorSwatchBarButton}"
                                            Margin="8,0,0,0" Click="BlankCanvasColorButton_Click" ToolTip="背景の色を選択">
                                        <Border x:Name="BlankCanvasColorSwatch" CornerRadius="5"
                                                Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="BlankCanvasColorEyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="BlankCanvasColorEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="BlankCanvasColorHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             Margin="6,0,0,0" ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="BlankCanvasColorHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <Popup x:Name="BlankCanvasColorPopup" PlacementTarget="{Binding ElementName=BlankCanvasColorButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="背景の色" Style="{StaticResource SectionHeader}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                    <Image x:Name="BlankCanvasColorWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                           MouseLeftButtonDown="BlankCanvasColorWheel_MouseDown"
                                                           MouseMove="BlankCanvasColorWheel_MouseMove"
                                                           MouseLeftButtonUp="BlankCanvasColorWheel_MouseUp" />
                                                    <Border x:Name="BlankCanvasColorWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                            BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                </Grid>
                                                            <Slider x:Name="BlankCanvasColorValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                                    ValueChanged="BlankCanvasColorValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColorRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColorRSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColorRBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColorRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColorGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColorGSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColorGBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColorGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColorBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColorBSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColorBBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColorBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Border x:Name="BlankCanvasColorPreviewLarge" Height="28" CornerRadius="6"
                                                        Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- 背景の色2: グラデーションon時のみ表示。UI/ロジックは
                                     色1と全く同じ構成をそのまま複製(BlankCanvasColor2*)。 -->
                                <Grid x:Name="BlankCanvasColor2Row" Margin="0,0,0,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="背景の色2" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="グラデーションのもう一方の色を選択" />
                                    <Button Grid.Column="1" x:Name="BlankCanvasColor2Button" Style="{StaticResource ColorSwatchBarButton}"
                                            Margin="8,0,0,0" Click="BlankCanvasColor2Button_Click" ToolTip="背景の色2を選択">
                                        <Border x:Name="BlankCanvasColor2Swatch" CornerRadius="5"
                                                Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="BlankCanvasColor2EyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="BlankCanvasColor2EyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="BlankCanvasColor2HexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             Margin="6,0,0,0" ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="BlankCanvasColor2HexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <Popup x:Name="BlankCanvasColor2Popup" PlacementTarget="{Binding ElementName=BlankCanvasColor2Button}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="背景の色2" Style="{StaticResource SectionHeader}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                    <Image x:Name="BlankCanvasColor2Wheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                           MouseLeftButtonDown="BlankCanvasColor2Wheel_MouseDown"
                                                           MouseMove="BlankCanvasColor2Wheel_MouseMove"
                                                           MouseLeftButtonUp="BlankCanvasColor2Wheel_MouseUp" />
                                                    <Border x:Name="BlankCanvasColor2WheelCursor" Width="12" Height="12" CornerRadius="6"
                                                            BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                </Grid>
                                                            <Slider x:Name="BlankCanvasColor2ValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                                    ValueChanged="BlankCanvasColor2ValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColor2RSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColor2RSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColor2RBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColor2RBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColor2GSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColor2GSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColor2GBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColor2GBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="BlankCanvasColor2BSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="BlankCanvasColor2BSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="BlankCanvasColor2BBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="BlankCanvasColor2BBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Border x:Name="BlankCanvasColor2PreviewLarge" Height="28" CornerRadius="6"
                                                        Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="グラデーション" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="背景の色1と色2の間をグラデーションにします" />
                                    <ToggleButton Grid.Column="1" x:Name="BlankCanvasGradientToggle" Style="{StaticResource SwitchToggleButton}"
                                                  HorizontalAlignment="Left" Margin="8,0,0,0"
                                                  Checked="BlankCanvasGradientToggle_Changed" Unchecked="BlankCanvasGradientToggle_Changed"
                                                  ToolTip="背景の色1と色2の間をグラデーションにします" />
                                </Grid>
                                <Grid x:Name="BlankCanvasGradientDirectionRow" Margin="0,0,0,6" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="方向" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" ToolTip="グラデーションの向き(度)" />
                                    <Slider Grid.Column="1" x:Name="BlankCanvasGradientDirectionSlider" Margin="8,0,0,0" Minimum="0" Maximum="360" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                            ValueChanged="BlankCanvasGradientDirectionSlider_ValueChanged" />
                                    <TextBox Grid.Column="2" x:Name="BlankCanvasGradientDirectionBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="BlankCanvasGradientDirectionBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PhotoLookCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource DimmableCard}" Padding="12" Margin="0,0,0,8">
                        <!-- StackPanel ではなく Grid(アバタールックカードと同じ対策):
                             リセットボタンをこの Border の下端に固定し、内容が短いときの
                             下の空白を防ぐ。

                             IsEnabled は CreateBlankCanvasButton_Click/TryLoadPhotoPixels
                             から切り替える: 背景なしキャンバス(実写真なし)有効中は
                             グレーアウト。 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="背景写真の見た目" Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center" />
                                <!-- アバタールックカードの LookLinkToggle のサイズに
                                     合わせた不可視プレースホルダ。これが無いとこのカードの
                                     ヘッダー行が反対側より短くなり、下の全スライダー行が
                                     2列間で縦にずれる。 -->
                                <ToggleButton Grid.Column="1" Style="{StaticResource LinkToggleButton}" Visibility="Hidden"
                                              IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                                <!-- MatchAvatarToPhotoButton の逆方向。
                                     MatchPhotoToAvatarButton_Click 参照。 -->
                                <Button x:Name="MatchPhotoToAvatarButton" Style="{StaticResource SecondaryPillButton}"
                                        HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,10" IsEnabled="False"
                                        Click="MatchPhotoToAvatarButton_Click" ToolTip="背景写真の見た目をアバター画像の現在の見た目に近づけます">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="14" Height="14" Stroke="White" StrokeThickness="2" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="アバターに近づける" />
                                    </StackPanel>
                                </Button>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoBrightnessLabel" Text="明るさ" Style="{StaticResource SliderRowLabel}" ToolTip="画像全体の明るさ" />
                                    <Slider Grid.Column="1" x:Name="PhotoBrightnessSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoBrightnessSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoBrightnessBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoBrightnessBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoContrastLabel" Text="コントラスト" Style="{StaticResource SliderRowLabel}" ToolTip="明暗の差の強さ" />
                                    <Slider Grid.Column="1" x:Name="PhotoContrastSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoContrastSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoContrastBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoContrastBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoSaturationLabel" Text="彩度" Style="{StaticResource SliderRowLabel}" ToolTip="色の鮮やかさ全体" />
                                    <Slider Grid.Column="1" x:Name="PhotoSaturationSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoSaturationSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoSaturationBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoSaturationBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoVibranceLabel" Text="自然な彩度" Style="{StaticResource SliderRowLabel}" ToolTip="彩度に近い効果ですが、すでに鮮やかな色は抑えめにして肌色などを保護します" />
                                    <Slider Grid.Column="1" x:Name="PhotoVibranceSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoVibranceSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoVibranceBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoVibranceBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoTemperatureLabel" Text="色温度" Style="{StaticResource SliderRowLabel}" ToolTip="画像を暖色(オレンジ)寄りか寒色(青)寄りにします" />
                                    <Slider Grid.Column="1" x:Name="PhotoTemperatureSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoTemperatureSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoTemperatureBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoTemperatureBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoTintLabel" Text="色合い" Style="{StaticResource SliderRowLabel}" ToolTip="画像を緑寄りかマゼンタ(赤紫)寄りにします" />
                                    <Slider Grid.Column="1" x:Name="PhotoTintSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoTintSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoTintBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoTintBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoHueLabel" Text="色相" Style="{StaticResource SliderRowLabel}" ToolTip="色全体を色相環上でずらします" />
                                    <Slider Grid.Column="1" x:Name="PhotoHueSlider" Minimum="-180" Maximum="180" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoHueSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoHueBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoHueBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoHighlightsLabel" Text="ハイライト" Style="{StaticResource SliderRowLabel}" ToolTip="明るい部分の明るさだけを調整します" />
                                    <Slider Grid.Column="1" x:Name="PhotoHighlightsSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoHighlightsSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoHighlightsBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoHighlightsBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoShadowsLabel" Text="シャドウ" Style="{StaticResource SliderRowLabel}" ToolTip="暗い部分の明るさだけを調整します" />
                                    <Slider Grid.Column="1" x:Name="PhotoShadowsSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoShadowsSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoShadowsBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoShadowsBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoWhitesLabel" Text="白レベル" Style="{StaticResource SliderRowLabel}" ToolTip="最も明るい白の締まり具合を調整します" />
                                    <Slider Grid.Column="1" x:Name="PhotoWhitesSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoWhitesSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoWhitesBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoWhitesBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoBlacksLabel" Text="黒レベル" Style="{StaticResource SliderRowLabel}" ToolTip="最も暗い黒の締まり具合を調整します" />
                                    <Slider Grid.Column="1" x:Name="PhotoBlacksSlider" Minimum="-100" Maximum="100" Ticks="0" VerticalAlignment="Center"
                                            ValueChanged="PhotoBlacksSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoBlacksBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoBlacksBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>
                                <!-- ティント: see the avatar-image side's own
                                     comment on this same row, identical
                                     luminance-preserving color-wash effect,
                                     independent instance for the photo. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="PhotoColorTintLabel" Text="ティント色" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="指定した色を強度に応じて重ねます(色相/色温度とは別の色被せ効果)" />
                                    <Button Grid.Column="1" x:Name="PhotoColorTintButton" Style="{StaticResource ColorSwatchBarButton}"
                                            Click="PhotoColorTintButton_Click" ToolTip="ティントの色を選択">
                                        <Border x:Name="PhotoColorTintSwatch" CornerRadius="5"
                                                Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="PhotoColorTintEyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="PhotoColorTintEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="PhotoColorTintHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="PhotoColorTintHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <Popup x:Name="PhotoColorTintPopup" PlacementTarget="{Binding ElementName=PhotoColorTintButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="ティント色" Style="{StaticResource SectionHeader}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                    <Image x:Name="PhotoColorTintWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                           MouseLeftButtonDown="PhotoColorTintWheel_MouseDown"
                                                           MouseMove="PhotoColorTintWheel_MouseMove"
                                                           MouseLeftButtonUp="PhotoColorTintWheel_MouseUp" />
                                                    <Border x:Name="PhotoColorTintWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                            BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                </Grid>
                                                            <Slider x:Name="PhotoColorTintValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    ValueChanged="PhotoColorTintValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="PhotoColorTintRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="PhotoColorTintRSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="PhotoColorTintRBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="PhotoColorTintRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="PhotoColorTintGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="PhotoColorTintGSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="PhotoColorTintGBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="PhotoColorTintGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                    <Slider Grid.Column="1" x:Name="PhotoColorTintBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                            ValueChanged="PhotoColorTintBSlider_ValueChanged" />
                                                    <TextBox Grid.Column="2" x:Name="PhotoColorTintBBox" Style="{StaticResource SliderRowBox}"
                                                             TextChanged="PhotoColorTintBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                </Grid>
                                                <Border x:Name="PhotoColorTintPreviewLarge" Height="28" CornerRadius="6"
                                                        Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- 専用行(アバター側ティントと同じ理由: ラベル+色ボタン行を
                                     共有するとスライダーが他より明らかに短くなる)。 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SliderRowLabel}" />
                                    <Slider Grid.Column="1" x:Name="PhotoColorTintStrengthSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="PhotoColorTintStrengthSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoColorTintStrengthBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoColorTintStrengthBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>

                                <!-- ぼかし は独立グループ。上の 一括調整 連動行とは別
                                     (アバター側に対応が無くリンク対象外)。アバター画像側の
                                     区切りに合わせてある。 -->
                                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,2,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ぼかし" Style="{StaticResource SliderRowLabel}" ToolTip="背景写真全体にぼかしをかけます(アバター画像を合成する前に適用されます)" />
                                    <Slider Grid.Column="1" x:Name="PhotoBlurSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="PhotoBlurSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                    <TextBox Grid.Column="2" x:Name="PhotoBlurBox" Style="{StaticResource SliderRowBox}"
                                             TextChanged="PhotoBlurBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                </Grid>

                            </StackPanel>
                            <Button Grid.Row="1" Style="{StaticResource SecondaryPillButton}"
                                    HorizontalAlignment="Left" Click="ResetPhotoLookButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                                            <TextBlock Text="リセット" />
                                        </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Spans both columns (Grid.Column="0" + ColumnSpan="3",
                         crossing the 12px spacer) now that 配置 no longer
                         occupies this row's col-0 slot (it floats over the
                         preview instead, see PlacementPanel): 11 sliders in
                         one narrow column made this card the tallest thing
                         on the page by far, so splitting them into 2
                         side-by-side sub-columns needed the extra width this
                         row's other column freed up. -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="仕上げエフェクト" Style="{StaticResource SectionHeader}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Reordered into 4 category groups (ディテール/トーン/光/フィルム・
                                     レトロ) instead of implementation order, split across the two
                                     sub-columns: column 0 holds ディテール+色褪せ+ブルーム+
                                     フィルム・レトロ(5項目), column 2 holds グラデーションと
                                     ライトリーク(どちらも色ピッカー付きで縦に長いブロック、
                                     ユーザー要望で右列にまとめた). -->
                                <StackPanel Grid.Column="0">
                                    <!-- ディテール -->
                                    <!-- Unlike ぼかし (photo only, before the
                                         avatar is composited on top), these
                                         two apply to the WHOLE final
                                         composite, avatar and photo together,
                                         closing the gap between a pixel-crisp
                                         render and a camera photo's natural
                                         softness, not faking depth of field. -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ソフトネス" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="画像全体を柔らかくぼかします" />
                                        <Slider Grid.Column="1" x:Name="SoftnessSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="SoftnessSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="SoftnessBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="SoftnessBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="シャープネス" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="画像全体の輪郭を強調します" />
                                        <Slider Grid.Column="1" x:Name="SharpnessSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="SharpnessSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="SharpnessBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="SharpnessBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="クラリティ" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="中間トーンの質感・立体感を強調します" />
                                        <Slider Grid.Column="1" x:Name="ClaritySlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="ClaritySlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="ClarityBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="ClarityBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <!-- トーン -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="色褪せ" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="黒を持ち上げて色を薄くし、古い写真のような褪せた印象にします" />
                                        <Slider Grid.Column="1" x:Name="FadeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="FadeSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="FadeBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="FadeBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <!-- 光 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ブルーム" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="明るい部分をふんわり滲ませて光らせます" />
                                        <Slider Grid.Column="1" x:Name="GlowSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="GlowSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="GlowBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="GlowBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <!-- フィルム・レトロ: フィルムグレイン・ビネット・色収差(R/Bチャンネル
                                         のズレ)・カラーブリード(色だけ横ににじむ)・スキャンライン(走査線+
                                         トラッキンググリッチ、まとめて1項目)。 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="フィルムグレイン" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="写真のようなノイズ(粒子感)を加えます" />
                                        <Slider Grid.Column="1" x:Name="GrainSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="GrainSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="GrainBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="GrainBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ビネット" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="四隅を暗くします" />
                                        <Slider Grid.Column="1" x:Name="VignetteSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="VignetteSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="VignetteBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="VignetteBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="色収差" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="色ズレを起こして、レンズの収差のような見た目にします" />
                                        <Slider Grid.Column="1" x:Name="ChromaticAberrationSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="ChromaticAberrationSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="ChromaticAberrationBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="ChromaticAberrationBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="色にじみ" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="色だけを横方向ににじませます(VHS風)" />
                                        <Slider Grid.Column="1" x:Name="ColorBleedSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="ColorBleedSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="ColorBleedBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="ColorBleedBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="スキャンライン" Style="{StaticResource SliderRowLabel}" Width="116" ToolTip="走査線とノイズでビデオ映像風の質感を加えます" />
                                        <Slider Grid.Column="1" x:Name="ScanlineSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="ScanlineSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="ScanlineBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="ScanlineBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <!-- タイトルのみの行 → 「・」付きの 方向/強さ 行。他の通常
                                         スライダー行と同じ3列(ラベル|コントロール|値)構成。
                                         ドロップシャドウ/ライトリークの再構成に合わせ、旧
                                         ラベル+ダイヤル+スライダーの巨大行を置き換えたもの。 -->
                                    <!-- 他行と同じ3列 Grid で包む(素の TextBlock ではない)ので、
                                         このラベルが上の行と同じ Column0 に入る。 -->
                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />

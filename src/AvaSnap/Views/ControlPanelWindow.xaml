                                        <Slider Grid.Column="1" x:Name="ToneGradientDirectionSlider" Margin="8,0,0,0" Minimum="0" Maximum="360" VerticalAlignment="Center"
                                                ValueChanged="ToneGradientDirectionSlider_ValueChanged"

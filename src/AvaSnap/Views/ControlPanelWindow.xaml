                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="ToneGradientLightColorRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="ToneGradientLightColorRSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="ToneGradientLightColorRBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="ToneGradientLightColorRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />

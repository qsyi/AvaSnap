                                        <TextBox Grid.Column="2" x:Name="ToneGradientDirectionBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="ToneGradientDirectionBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <!-- ・明色/・暗色: same swatch-bar+eyedropper+hex UI as every
                                         other color row (・色 above). Manual, no longer recomputed
                                         every render; see ToneGradientAutoDetectButton above and
                                         GpuToneGradient.TryDetectColors. -->

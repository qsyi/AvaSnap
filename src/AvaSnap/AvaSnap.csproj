<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by ComputeSharp's [GeneratedComputeShaderDescriptor]
         source generator (see Services/GpuColorAdjustments.cs) to emit the
         shader descriptor code it needs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <RootNamespace>AvaSnap</RootNamespace>
    <AssemblyName>AvaSnap</AssemblyName>

    <!-- Program.cs supplies its own Main (VelopackApp.Build().Run() must
         run before WPF starts; see its own doc comment); this tells the
         compiler to use that one instead of the one WPF's build targets
         would otherwise auto-generate from App.xaml. -->
    <StartupObject>AvaSnap.Program</StartupObject>

    <!-- Source of truth for UpdateService's version comparison and the
         version number AboutPanel displays. Bump this alongside every
         release packaged with vpk pack for qsyi-dist/as-rel. -->
    <Version>1.0.0</Version>

    <!-- Distribution: Velopack-managed install (Setup.exe into a versioned
         folder under %LocalAppData%, with in-place updates); see
         Services/UpdateService.cs. No longer a single portable exe:
         PublishSingleFile is incompatible with Velopack, which needs the
         individual publish-output files to build delta packages between
         versions. `dotnet publish` output here is an input to `vpk pack`,
         not the distributed artifact itself. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- The exe's own file icon (Explorer, taskbar when not running,
         shortcuts). Pass the same file to vpk pack's icon option when
         packaging a release so Setup.exe/the installed shortcuts match too. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Zen Maru Gothic (SIL Open Font License, free for commercial use) is
       embedded as a WPF resource rather than relied upon as a system font,
       so it doesn't depend on being separately installed on whatever
       machine runs the app. -->
  <ItemGroup>
    <Resource Include="Fonts\ZenMaruGothic-Medium.ttf" />
    <!-- Also embedded as a WPF resource (separately from ApplicationIcon
         above) so Window.Icon can reference it via pack:// for the
         runtime title-bar/taskbar/alt-tab icon while the app is running. -->
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <!-- Embedded (not just committed to the repo) so LicensePanel/AboutPanel
       can display these from inside the shipped exe with no network access
       needed: several of the notices in THIRD-PARTY-NOTICES.md (SIL OFL,
       MIT) require staying viewable alongside the redistributed software
       itself, not just in the source repo. Link keeps one copy of each
       file at the repo root instead of duplicating them under this
       project. -->
  <ItemGroup>
    <Resource Include="..\..\LICENSE.md" Link="Assets\LICENSE.md" />
    <Resource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
    <Resource Include="..\..\PATCHNOTES.md" Link="Assets\PATCHNOTES.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- 深度依存ぼかし(被写界深度)用の Depth Anything V2 Small 推論。DirectML EP で
         既存要件の DX12 GPU 上で走る。ネイティブ onnxruntime.dll / DirectML.dll は
         win-x64 self-contained publish に含まれる。モデル(.onnx)は同梱せず初回DL
         (Services/DepthModel.cs)。ライセンス: ORT/DirectML=MIT、モデル=Apache-2.0。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

</Project>

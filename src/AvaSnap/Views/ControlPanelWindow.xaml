                                        FontSize="13" Padding="14,6" Click="AddDecalButton_Click" />
                            </Grid>
                            <TextBlock Text="右にあるほど手前に表示されます。ドラッグで並べ替え、「アバター」より左に動かすとアバターの後ろに配置されます。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DecalLayerStrip" Orientation="Horizontal" MinHeight="64" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Anchor for the 一括調整 connector adorner (see
                         EnsureLookLinkAdorner/PositionLookLinkConnector in
                         ControlPanelWindow.xaml.cs): always present (never
                         Collapsed, so its layout position is always valid to
                         read), with zero visual content of its own. The
                         actual bar+icon are added to its AdornerLayer. -->
                    <Grid Grid.Row="1" Grid.Column="1" x:Name="LookLinkConnector" />
                </Grid>
                </ScrollViewer>
                <!-- Pinned to the cards column's own top edge (a sibling
                     drawn AFTER the ScrollViewer, not inside it) so it stays
                     put regardless of scroll position instead of needing to
                     scroll up to rediscover why every slider stopped
                     responding. Shared by every "preview interaction mode"
                     that wants exclusive ownership of the preview's drag
                     gestures (currently 切り抜きモード and アバター配置モード,
                     see RefreshSliderLockState in code-behind, the one
                     common choke point both modes' _Changed handlers call);
                     adding a future mode just means adding its own flag to
                     that method's own locked check, not touching this
                     element again. -->
                <Border x:Name="SliderLockNotice" Grid.Row="0" Grid.Column="2"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,14,16,0"
                        Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="切り抜きモード・アバター配置モード中はスライダーを変更できません" FontSize="12"
                               Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </Border>
        </Grid>

        <!-- Compact: shrinks the whole window down to a small corner widget
             so it doesn't cover VRChat while positioning things live. -->
        <Grid x:Name="CompactPanel" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="14" Margin="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="AvaSnap" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock x:Name="CompactModeText" Text="位置合わせモード" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="元に戻す" Style="{StaticResource SecondaryPillButton}"
                            Padding="12,7" VerticalAlignment="Center" Click="ExpandButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- バージョン情報: opened from HomeSettingsPanel's own button, or
             from TitleBarUpdateButton when an update is available, not part
             of the Home/Align/Composite work-mode rotation, so it just
             reuses BackToHome_Click to return rather than getting its own
             PanelMode. PatchNotesText is populated in code-behind (see
             ShowAbout) from PATCHNOTES.md, embedded as a WPF resource (see
             the csproj) so it's readable with no network access. License/
             third-party notices live in the separate LicensePanel instead
             (see below); see LicenseButton_Click. -->
        <Grid x:Name="AboutPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="&#8592; ホーム" Style="{StaticResource BackButton}"
                    HorizontalAlignment="Left" Margin="12,12,0,0" Click="BackToHome_Click" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="AvaSnap" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock x:Name="AboutVersionText" Text="" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,20" />

                    <!-- Populated in code-behind (see ShowAbout/RefreshUpdateSection):
                         UpdateVersionCombo's items are built programmatically
                         from UpdateService.GetAvailableVersionsAsync (every
                         published version, newest first, each ComboBoxItem's
                         Tag holding the underlying VelopackAsset), since
                         that list isn't known until the GitHub feed is
                         actually read. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="アップデート" Style="{StaticResource SectionHeader}" />
                            <TextBlock x:Name="UpdateStatusText" Text="" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <Grid x:Name="UpdateVersionRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="UpdateVersionCombo" Style="{StaticResource CompactComboBox}"
                                          HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                <Button Grid.Column="1" x:Name="UpdateApplyButton" Content="適用して再起動" Style="{StaticResource PillButton}"
                                        FontSize="13" Padding="14,7" Click="UpdateApplyButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="パッチノート" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="PatchNotesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ライセンス: LICENSE.md/THIRD-PARTY-NOTICES.md, split out of
             AboutPanel into their own screen (same rationale as
             AboutPanel's own doc comment: embedded WPF resources, no
             network access needed). -->
        <Grid x:Name="LicensePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="&#8592; ホーム" Style="{StaticResource BackButton}"
                    HorizontalAlignment="Left" Margin="12,12,0,0" Click="BackToHome_Click" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="ライセンス" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" Margin="0,0,0,20" />

                    <TextBlock Text="サードパーティ通知" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="ThirdPartyNoticesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Unity連携ガイド: 位置合わせモードのFOVガイド内「Unity連携は
             こちらから」ボタン(OpenUnityIntegrationGuideButton_Click)で開く、
             上から降りてくるオーバーレイ。HomePanel/AlignPanel/...のような
             画面切り替えではなく、ルートGridの最後に宣言することで今表示中の
             画面の上に重ねて表示する(Grid.RowSpan="2"でタイトルバーの下に
             かぶさる)。スクリムをクリックしても閉じる。 -->
        <Grid x:Name="UnityIntegrationGuideOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#88000000" MouseLeftButtonDown="UnityIntegrationGuideScrim_MouseLeftButtonDown" />
            <Border x:Name="UnityIntegrationGuidePanel" Style="{StaticResource Card}"
                    VerticalAlignment="Top" Margin="16,16,16,0" Padding="16"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="UnityIntegrationGuideTransform" Y="-400" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unity連携" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#10005;" Style="{StaticResource BackButton}"
                                Padding="8,4" Click="CloseUnityIntegrationGuideButton_Click" />
                    </Grid>

                    <TextBlock Text="① VCCにリポジトリを登録" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <TextBlock Text="下のボタンでVRChat Creator Companion(VCC)に、AvaSnap連携のパッケージリポジトリを登録します。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="VCCに追加" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left" Click="AddToVccButton_Click" />

                    <TextBlock Text="② プロジェクトへインストール" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4" />
                    <TextBlock Text="VCCで対象のUnityプロジェクトを開き、パッケージ一覧から「AvaSnap連携」を探してAddしてください。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </AdornerDecorator>
</Window>

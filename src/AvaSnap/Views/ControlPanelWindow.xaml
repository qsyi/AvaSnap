                                                    Background="#FF60A0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                        </Button>
                                        <Button Grid.Column="2" x:Name="LightLeakEyedropperButton" Style="{StaticResource RotateIconButton}"
                                                Margin="6,0,0,0" Click="LightLeakEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                            <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                        </Button>
                                        <TextBox Grid.Column="3" x:Name="LightLeakColorHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                                 ToolTip="カラーコード(#RRGGBB)"
                                                 TextChanged="LightLeakColorHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                        <Popup x:Name="LightLeakColorPopup" PlacementTarget="{Binding ElementName=LightLeakColorButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                                <StackPanel>
                                                    <TextBlock Text="光の色" Style="{StaticResource SectionHeader}" />
                                                    <UniformGrid Columns="4" Margin="0,0,0,10">
                                                        <Button Style="{StaticResource ColorPresetButton}" Background="#FFA03C" Click="LightLeakColorPreset_Click" ToolTip="暖色" />
                                                        <Button Style="{StaticResource ColorPresetButton}" Background="#5AAAFF" Click="LightLeakColorPreset_Click" ToolTip="寒色" />
                                                        <Button Style="{StaticResource ColorPresetButton}" Background="#FFFFFF" Click="LightLeakColorPreset_Click" ToolTip="白" />
                                                    </UniformGrid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Grid Width="140" Height="140">
                                                        <Image x:Name="LightLeakColorWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                               MouseLeftButtonDown="LightLeakColorWheel_MouseDown"
                                                               MouseMove="LightLeakColorWheel_MouseMove"
                                                               MouseLeftButtonUp="LightLeakColorWheel_MouseUp" />
                                                        <Border x:Name="LightLeakColorWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                                BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                    </Grid>
                                                            <Slider x:Name="LightLeakColorValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                                    Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                                    ValueChanged="LightLeakColorValueSlider_ValueChanged" />
                                                        </StackPanel>
                                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Margin="0,2,0,8" />
                                                    <TextBlock Text="サブ: RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,0,4" />
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="R" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="LightLeakColorRSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="LightLeakColorRSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="LightLeakColorRBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="LightLeakColorRBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="G" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="LightLeakColorGSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="LightLeakColorGSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="LightLeakColorGBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="LightLeakColorGBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="B" Style="{StaticResource SliderRowLabel}" Width="20" />
                                                        <Slider Grid.Column="1" x:Name="LightLeakColorBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="LightLeakColorBSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="LightLeakColorBBox" Style="{StaticResource SliderRowBox}"
                                                                 TextChanged="LightLeakColorBBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                                    </Grid>
                                                    <Border x:Name="LightLeakColorPreviewLarge" Height="28" CornerRadius="6"
                                                            Background="#FF60A0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="・強さ" Style="{StaticResource SliderRowLabel}" Width="116"
                                                   ToolTip="光の強さ" Opacity="0.7" />
                                        <Slider Grid.Column="1" x:Name="LightLeakSlider" Margin="8,0,0,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                ValueChanged="LightLeakSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="PhotoColorSliderMouseDown" PreviewMouseLeftButtonUp="PhotoColorSliderMouseUp" />
                                        <TextBox Grid.Column="2" x:Name="LightLeakBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="LightLeakBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="・方向" Style="{StaticResource SliderRowLabel}" Width="116"
                                                   ToolTip="光の向き(度)" Opacity="0.7" />
                                        <!-- The dial used to also control _lightLeakDistance (how far
                                             the light's anchor pulls in from the frame's edge toward
                                             its center) via how far inside the square you dragged.
                                             With the dial gone, distance is no longer user-adjustable
                                             and just stays fixed at 1.0 (the edge), same as グラデーション/
                                             ドロップシャドウ's own direction controls always were. -->

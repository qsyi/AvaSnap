                                                        <Slider Grid.Column="1" x:Name="ToneGradientLightColorBSlider" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                                ValueChanged="ToneGradientLightColorBSlider_ValueChanged" />
                                                        <TextBox Grid.Column="2" x:Name="ToneGradientLightColorBBox" Style="{StaticResource SliderRowBox}"

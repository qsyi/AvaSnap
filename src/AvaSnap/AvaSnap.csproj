<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by ComputeSharp's [GeneratedComputeShaderDescriptor]
         source generator (see Services/GpuColorAdjustments.cs) to emit the
         shader descriptor code it needs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <RootNamespace>AvaSnap</RootNamespace>
    <AssemblyName>AvaSnap</AssemblyName>

    <!-- Program.cs supplies its own Main (VelopackApp.Build().Run() must
         run before WPF starts; see its own doc comment); this tells the
         compiler to use that one instead of the one WPF's build targets
         would otherwise auto-generate from App.xaml. -->
    <StartupObject>AvaSnap.Program</StartupObject>

    <!-- Source of truth for UpdateService's version comparison and the
         version number AboutPanel displays. Bump this alongside every
         release packaged with `vpk pack` for qsyi/avasnap. -->
    <Version>0.1.0</Version>

    <!-- Distribution: Velopack-managed install (Setup.exe into a versioned
         folder under %LocalAppData%, with in-place updates); see
         Services/UpdateService.cs. No longer a single portable exe:
         PublishSingleFile is incompatible with Velopack, which needs the
         individual publish-output files to build delta packages between
         versions. `dotnet publish` output here is an input to `vpk pack`,
         not the distributed artifact itself. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Zen Maru Gothic (SIL Open Font License, free for commercial use) is
       embedded as a WPF resource rather than relied upon as a system font,
       so it doesn't depend on being separately installed on whatever
       machine runs the app. -->
  <ItemGroup>
    <Resource Include="Fonts\ZenMaruGothic-Medium.ttf" />
  </ItemGroup>

  <!-- Embedded (not just committed to the repo) so AboutPanel can display
       the license and third-party notices from inside the shipped exe with
       no network access needed: several of those notices (SIL OFL, MIT)
       require staying viewable alongside the redistributed software itself,
       not just in the source repo. Link keeps one copy of each file at the
       repo root (where GitHub expects LICENSE to live) instead of
       duplicating them under this project. -->
  <ItemGroup>
    <Resource Include="..\..\LICENSE.md" Link="Assets\LICENSE.md" />
    <Resource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>

                                                    Background="Black" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                        </Button>
                                        <Button Grid.Column="2" x:Name="ToneGradientDarkEyedropperButton" Style="{StaticResource RotateIconButton}"
                                                Margin="6,0,0,0" Click="ToneGradientDarkEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                            <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                        </Button>
                                        <TextBox Grid.Column="3" x:Name="ToneGradientDarkHexBox" Style="{StaticResource SliderRowBox}" Width="100"

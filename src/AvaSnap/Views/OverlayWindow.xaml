<Window x:Class="AvaSnap.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AvaSnap Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- ここに Background は付けない(WPF では Transparent ブラシと違い、Background
         無しはヒットテスト対象にならない)。この Canvas は仮想スクリーン全域に
         広がるので、Transparent Background だとクリックスルー OFF 時にどのモニタの
         どこのクリックも吸ってしまう。 -->
    <Canvas x:Name="RootCanvas">
        <!-- Unity連携ガイド: FOV/pitch/roll は Unity の
             CameraCompositionGuideExporter エディタスクリプトが書き出すファイルから
             読む(UnityCameraGuideService 参照)。純粋な構図の参照で保存物には
             焼き込まれないため、クリックスルー中も表示され続ける(専用ドラッグ
             ハンドルは無く、Unity が駆動する)。OverlayImage より前(=背面)に
             置くので、アバター PNG が不透明な箇所は自然にガイドを覆い、透明な箇所は
             下のガイドが完全な不透明度で透けて見える。 -->
        <!-- Canvas を1つでなく2重にする理由: 要素の ClipToBounds/Clip はその要素の
             ローカル空間で切り抜き、そのあと RenderTransform が乗るので、ロール回転した
             UnityGuideCanvas を自身の bounds で切り抜くと回転した矩形シルエットになり、
             回転した隅で線が枠外へはみ出す(または内側で切れる)。対策がこの外側の
             決して回転しない UnityGuideFrameClip: その Clip/bounds は内側の回転に
             関わらずスクリーン空間で軸平行のまま。 -->
        <Canvas x:Name="UnityGuideFrameClip" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">
            <Canvas x:Name="UnityGuideCanvas" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="UnityGuideRollRotate" />
                </Canvas.RenderTransform>
            </Canvas>
        </Canvas>

        <Image x:Name="OverlayImage"
               Stretch="Fill"
               RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="OverlayImage_MouseLeftButtonDown"
               MouseLeftButtonUp="OverlayImage_MouseLeftButtonUp"
               MouseMove="OverlayImage_MouseMove">
            <Image.RenderTransform>
                <RotateTransform x:Name="ImageRotateTransform" />
            </Image.RenderTransform>
        </Image>

        <!-- リサイズハンドル: 四隅グリップのみ。オーバーレイが操作可能な間
             (クリックスルー OFF)表示。常にアス比固定でスケール。下の同角度変換で
             画像と一緒に回転するので、回転した画像の隅にグリップが乗ったままになる。 -->
        <Canvas x:Name="HandlesLayer" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="HandlesRotateTransform" />
            </Canvas.RenderTransform>

            <Rectangle x:Name="HandleTL" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                       Cursor="SizeNWSE" Tag="TL" MouseLeftButtonDown="Handle_MouseLeftButtonDown"
                       MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
            <Rectangle x:Name="HandleTR" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                       Cursor="SizeNESW" Tag="TR" MouseLeftButtonDown="Handle_MouseLeftButtonDown"
                       MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
            <Rectangle x:Name="HandleBL" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                       Cursor="SizeNESW" Tag="BL" MouseLeftButtonDown="Handle_MouseLeftButtonDown"
                       MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />
            <Rectangle x:Name="HandleBR" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1"
                       Cursor="SizeNWSE" Tag="BR" MouseLeftButtonDown="Handle_MouseLeftButtonDown"
                       MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseLeftButtonUp" />

            <!-- 回転ギズモ: ボックス上端中央の上にあるハンドルを細い引き出し線で
                 つなぎ、中心まわりの弧に沿ってドラッグして回転する。中心ちょうどでなく
                 オフセットしてあるのは、掴んだ瞬間から角度が定義できるようにするため。 -->
            <Line x:Name="RotateGizmoLine" Stroke="White" StrokeThickness="2" />
            <!-- Width/Height を 12 → 16 に(UpdateHandles の gizmoHalf 参照)。
                 12px は通常の UI スケールで掴み損ねやすかった。 -->
            <Ellipse x:Name="RotateGizmoHandle" Width="16" Height="16" Fill="White" Stroke="Black" StrokeThickness="1"
                     Cursor="Hand" MouseLeftButtonDown="RotateGizmo_MouseLeftButtonDown"
                     MouseMove="RotateGizmo_MouseMove" MouseLeftButtonUp="RotateGizmo_MouseLeftButtonUp" />
        </Canvas>
    </Canvas>
</Window>

                                        <TextBox Grid.Column="2" x:Name="LightLeakDirectionBox" Style="{StaticResource SliderRowBox}"
                                                 TextChanged="LightLeakDirectionBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    </Grid>

                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource SecondaryPillButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetFinishButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{StaticResource RotateCcwIcon}" />
                                            <TextBlock Text="リセット" />
                                        </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- デカール: ステッカー的な追加画像。DecalLayerStripの中身は
                         コード側で組み立てる(可変長+ドラッグ並べ替えのため)。
                         並び順=描画順(右ほど手前)。中の「アバター」マーカーは
                         削除できない固定エントリで、これより左のデカールは
                         アバターの後ろに、右は前に合成される。 -->
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="デカール" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="画像を追加" Style="{StaticResource SecondaryPillButton}"
                                        FontSize="13" Padding="14,6" Click="AddDecalButton_Click" />
                            </Grid>
                            <!-- 図形デカールは「枠線」のみ(ShapeRasterizer)。追加後は
                                 画像デカールと同じ配置モードに乗り、角=アス比固定の
                                 拡縮 / 辺=その軸だけ変更、で編集する。下の図形プロパティ
                                 (色/太さ)も参照。 -->
                            <Button HorizontalAlignment="Left" Margin="0,0,0,8"
                                    Style="{StaticResource SecondaryPillButton}" FontSize="13" Padding="14,6"
                                    Click="AddRectangleFrameDecal_Click" ToolTip="写真の縁取り用の枠線を追加">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                        <Rectangle Width="16" Height="13" Stroke="White" StrokeThickness="2" />
                                    </Viewbox>
                                    <TextBlock Text="枠線を追加" />
                                </StackPanel>
                            </Button>
                            <!-- デカール(画像/枠線とも)配置中に表示。個別の不透明度。 -->
                            <Grid x:Name="DecalOpacityRow" Visibility="Collapsed" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="不透明度" Style="{StaticResource SliderRowLabel}" Width="60"
                                           VerticalAlignment="Center" ToolTip="このデカールの不透明度" />
                                <Slider Grid.Column="1" x:Name="DecalOpacitySlider" Margin="8,0,0,0" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                        ValueChanged="DecalOpacitySlider_ValueChanged" />
                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <!-- 図形デカール配置中のみ表示(UpdateShapeDecalPanel)。
                                 色UIはアプリ内の他ピッカーと同じ色相環+明度+hex+
                                 スポイト+プリセット。 -->
                            <StackPanel x:Name="ShapeDecalPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="図形の色" Style="{StaticResource SliderRowLabel}" Width="60"
                                               VerticalAlignment="Center" ToolTip="図形の色を選択" />
                                    <Button Grid.Column="1" x:Name="ShapeDecalColorButton" Style="{StaticResource ColorSwatchBarButton}"
                                            Click="ShapeDecalColorButton_Click" ToolTip="図形の色を選択">
                                        <Border x:Name="ShapeDecalColorSwatch" CornerRadius="5"
                                                Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="ShapeDecalColorEyedropperButton" Style="{StaticResource RotateIconButton}"
                                            Margin="6,0,0,0" Click="ShapeDecalColorEyedropperButton_Click" ToolTip="プレビューから色を拾う">
                                        <ContentPresenter Content="{StaticResource EyedropperIcon}" />
                                    </Button>
                                    <TextBox Grid.Column="3" x:Name="ShapeDecalColorHexBox" Style="{StaticResource SliderRowBox}" Width="100"
                                             Margin="6,0,0,0" ToolTip="カラーコード(#RRGGBB)"
                                             TextChanged="ShapeDecalColorHexBox_TextChanged" GotFocus="Field_GotFocus" LostFocus="Field_LostFocus" />
                                    <Popup x:Name="ShapeDecalColorPopup" PlacementTarget="{Binding ElementName=ShapeDecalColorButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Style="{StaticResource Card}" Padding="12" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="図形の色" Style="{StaticResource SectionHeader}" />
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <Button Style="{StaticResource ColorPresetButton}" Background="#FFFFFF" Tag="#FFFFFF" Click="ShapeDecalColorPreset_Click" ToolTip="白" />
                                                    <Button Style="{StaticResource ColorPresetButton}" Background="#000000" Tag="#000000" Click="ShapeDecalColorPreset_Click" ToolTip="黒" />
                                                    <Button Style="{StaticResource ColorPresetButton}" Background="#FF4D4D" Tag="#FF4D4D" Click="ShapeDecalColorPreset_Click" ToolTip="赤" />
                                                    <Button Style="{StaticResource ColorPresetButton}" Background="#4D8CFF" Tag="#4D8CFF" Click="ShapeDecalColorPreset_Click" ToolTip="青" />
                                                </UniformGrid>
                                                <!-- 色相環 と、その右に縦の明度スライダー(共通スタイル
                                                     BrightnessSliderVertical: グラデーション帯そのものが
                                                     トラック)。上=明るい/下=暗い。 -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <Grid Width="140" Height="140">
                                                        <Image x:Name="ShapeDecalColorWheel" Width="140" Height="140" Stretch="Fill" Cursor="Hand"
                                                               MouseLeftButtonDown="ShapeDecalColorWheel_MouseDown"
                                                               MouseMove="ShapeDecalColorWheel_MouseMove"
                                                               MouseLeftButtonUp="ShapeDecalColorWheel_MouseUp" />
                                                        <Border x:Name="ShapeDecalColorWheelCursor" Width="12" Height="12" CornerRadius="6"
                                                                BorderBrush="White" BorderThickness="2" IsHitTestVisible="False"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,64,0,0" />
                                                    </Grid>
                                                    <Slider x:Name="ShapeDecalColorValueSlider" Style="{StaticResource BrightnessSliderVertical}"
                                                            Height="140" Margin="12,0,0,0" Minimum="0" Maximum="100" ToolTip="明度"
                                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                                            ValueChanged="ShapeDecalColorValueSlider_ValueChanged" />
                                                </StackPanel>
                                                <Border x:Name="ShapeDecalColorPreviewLarge" Height="28" CornerRadius="6"
                                                        Background="White" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid x:Name="ShapeDecalStrokeRow" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="線の太さ" Style="{StaticResource SliderRowLabel}" Width="60"
                                               VerticalAlignment="Center" ToolTip="短辺に対する線幅(%)" />
                                    <Slider Grid.Column="1" x:Name="ShapeDecalStrokeSlider" Margin="8,0,0,0" Minimum="0.5" Maximum="20"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                            ValueChanged="ShapeDecalStrokeSlider_ValueChanged" />
                                    <TextBlock Grid.Column="2" Text="%" Style="{StaticResource SliderRowLabel}" Width="Auto"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="右にあるほど手前に表示されます。ドラッグで並べ替え、「アバター」より左に動かすとアバターの後ろに配置されます。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DecalLayerStrip" Orientation="Horizontal" MinHeight="64" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- マスクレイヤー: 効果の効き具合を塗って作るグレースケール。
                         「マスクを追加」→ デカールと同じ枠組みの編集モード(切り抜き後
                         キャンバスを表示 + 下部 PreviewModeConfirmBar)。既定は全面 白(効果1)。
                         ペン=黒を塗る(効果0) / 消しゴム=黒を消す(効果1へ戻す) / グラデーション。
                         作ったマスクはアバター・背景の色調補正・トーングラデ・ライトリークの
                         各行の「マスク」欄から割り当てる。詳細は ControlPanelWindow.Masks.cs。 -->
                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="MaskLayerCard"
                            Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="マスクレイヤー" Style="{StaticResource SectionHeader}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="AddMaskButton" Content="マスクを追加"
                                        Style="{StaticResource SecondaryPillButton}" FontSize="13" Padding="14,6"
                                        Click="AddMaskButton_Click" />
                            </Grid>

                            <Border x:Name="MaskLimitNotice" Visibility="Collapsed" Margin="0,0,0,8"
                                    Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <TextBlock Text="マスクは3個までです" FontSize="12"
                                           Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock x:Name="MaskEmptyHint"
                                       Text="「マスクを追加」で作成します。黒く塗ったところが効果の効かない範囲になります。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <StackPanel x:Name="MaskLayerList" Margin="0,0,0,2" />

                            <!-- スライダーへの割り当て。マスクが1つ以上ある時だけ表示
                                 (RefreshMaskChips)。対象 = 写真の色調補正12項目 +
                                 トーングラデーション + ライトリーク。 -->
                            <StackPanel x:Name="MaskAssignPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,8" />
                                <Button x:Name="MaskAssignToggleButton" Style="{StaticResource SecondaryPillButton}"
                                        FontSize="12" Padding="12,5" HorizontalAlignment="Left"
                                        Content="スライダーに割り当て" Click="ToggleMaskAssignSection" />
                                <StackPanel x:Name="MaskAssignRows" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- 編集モード中のみ表示(EnterMaskEditMode / ExitMaskEditMode)。 -->
                            <StackPanel x:Name="MaskEditToolbar" Visibility="Collapsed" Margin="0,6,0,0">
                                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,8" />

                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="MaskToolPen" GroupName="MaskTool" Style="{StaticResource AspectRatioRadioButton}"
                                                 Content="ペン" Margin="0,0,6,0" Checked="MaskTool_Checked"
                                                 ToolTip="なぞった所に黒を塗る = 効果を効かなくする" />
                                    <RadioButton x:Name="MaskToolErase" GroupName="MaskTool" Style="{StaticResource AspectRatioRadioButton}"
                                                 Content="消しゴム" Margin="0,0,6,0" Checked="MaskTool_Checked"
                                                 ToolTip="黒を消す = 効果を効かせる(ペンの修正用)" />
                                    <RadioButton x:Name="MaskToolGradient" GroupName="MaskTool" Style="{StaticResource AspectRatioRadioButton}"
                                                 Content="グラデーション" Checked="MaskTool_Checked"
                                                 ToolTip="ドラッグでグラデーションを1つ配置。ハンドルで再調整" />
                                </WrapPanel>

                                <WrapPanel x:Name="MaskGradientKindPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <RadioButton x:Name="MaskGradLinear" GroupName="MaskGradKind" Style="{StaticResource AspectRatioRadioButton}"
                                                 Content="線形" Margin="0,0,6,0" Checked="MaskGradKind_Checked" />
                                    <RadioButton x:Name="MaskGradRadial" GroupName="MaskGradKind" Style="{StaticResource AspectRatioRadioButton}"
                                                 Content="円形" Checked="MaskGradKind_Checked" />
                                </WrapPanel>

                                <Grid x:Name="MaskBrushSizeRow" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="サイズ" Style="{StaticResource SliderRowLabel}" Width="60"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" x:Name="MaskBrushSizeSlider" Margin="8,0,0,0" Minimum="1" Maximum="100"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                            ValueChanged="MaskBrushSizeSlider_ValueChanged" />
                                </Grid>
                                <Grid x:Name="MaskBrushFeatherRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ぼかし" Style="{StaticResource SliderRowLabel}" Width="60"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" x:Name="MaskBrushFeatherSlider" Margin="8,0,0,0" Minimum="0" Maximum="100"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="Field_MouseDown" PreviewMouseLeftButtonUp="Field_MouseUp"
                                            ValueChanged="MaskBrushFeatherSlider_ValueChanged" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="全消去" Style="{StaticResource SecondaryPillButton}" FontSize="12" Padding="12,5"
                                            Margin="0,0,6,0" Click="MaskClearAllButton_Click" ToolTip="全面を効果1に(黒を全部消す = 既定に戻す)" />
                                    <Button Content="全塗り" Style="{StaticResource SecondaryPillButton}" FontSize="12" Padding="12,5"
                                            Margin="0,0,12,0" Click="MaskFillAllButton_Click" ToolTip="全面を効果0に(全部黒く塗る)" />
                                    <ToggleButton x:Name="MaskInvertCheck" Style="{StaticResource PillToggleButton}"
                                                  VerticalAlignment="Center"
                                                  Checked="MaskInvertCheck_Changed" Unchecked="MaskInvertCheck_Changed"
                                                  ToolTip="効果の効く所と効かない所を入れ替える">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M8 3 4 7l4 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M4 7h16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="m16 21 4-4-4-4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Data="M20 17H4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="反転" />
                                        </StackPanel>
                                    </ToggleButton>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Anchor for the 一括調整 connector adorner (see
                         EnsureLookLinkAdorner/PositionLookLinkConnector in
                         ControlPanelWindow.xaml.cs): always present (never
                         Collapsed, so its layout position is always valid to
                         read), with zero visual content of its own. The
                         actual bar+icon are added to its AdornerLayer. -->
                    <Grid Grid.Row="1" Grid.Column="1" x:Name="LookLinkConnector" />
                </Grid>
                </ScrollViewer>
                <!-- Pinned to the cards column's own top edge (a sibling
                     drawn AFTER the ScrollViewer, not inside it) so it stays
                     put regardless of scroll position instead of needing to
                     scroll up to rediscover why every slider stopped
                     responding. Shared by every "preview interaction mode"
                     that wants exclusive ownership of the preview's drag
                     gestures (currently 切り抜きモード and アバター配置モード,
                     see RefreshSliderLockState in code-behind, the one
                     common choke point both modes' _Changed handlers call);
                     adding a future mode just means adding its own flag to
                     that method's own locked check, not touching this
                     element again. -->
                <Border x:Name="SliderLockNotice" Grid.Row="0" Grid.Column="2"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,14,16,0"
                        Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="切り抜きモード・アバター配置モード中はスライダーを変更できません" FontSize="12"
                               Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </Border>
        </Grid>

        <!-- コンパクト: 窓全体を隅の小ウィジェットに縮め、ライブ調整中に
             VRChat を覆わないようにする。 -->
        <Grid x:Name="CompactPanel" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="14" Margin="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="AvaSnap" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock x:Name="CompactModeText" Text="位置合わせモード" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="元に戻す" Style="{StaticResource SecondaryPillButton}"
                            Padding="12,7" VerticalAlignment="Center" Click="ExpandButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- バージョン情報: opened from HomeSettingsPanel's own button, or
             from TitleBarUpdateButton when an update is available, not part
             of the Home/Align/Composite work-mode rotation, so it just
             reuses BackToHome_Click to return rather than getting its own
             PanelMode. PatchNotesText is populated in code-behind (see
             ShowAbout) from PATCHNOTES.md, embedded as a WPF resource (see
             the csproj) so it's readable with no network access. License/
             third-party notices live in the separate LicensePanel instead
             (see below); see LicenseButton_Click. -->
        <Grid x:Name="AboutPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="&#8592; ホーム" Style="{StaticResource BackButton}"
                    HorizontalAlignment="Left" Margin="12,12,0,0" Click="BackToHome_Click" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="AvaSnap" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock x:Name="AboutVersionText" Text="" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,20" />

                    <!-- コードビハインドで生成(ShowAbout/RefreshUpdateSection):
                         UpdateVersionCombo の項目は UpdateService.GetAvailableVersionsAsync
                         から作る(公開済み全バージョン、新しい順、各 ComboBoxItem の
                         Tag に VelopackAsset)。この一覧は GitHub フィードを読むまで
                         分からないため。 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="アップデート" Style="{StaticResource SectionHeader}" />
                            <TextBlock x:Name="UpdateStatusText" Text="" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <Grid x:Name="UpdateVersionRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="UpdateVersionCombo" Style="{StaticResource CompactComboBox}"
                                          HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                <Button Grid.Column="1" x:Name="UpdateApplyButton" Content="適用して再起動" Style="{StaticResource PillButton}"
                                        FontSize="13" Padding="14,7" Click="UpdateApplyButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="パッチノート" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="PatchNotesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ライセンス: LICENSE.md/THIRD-PARTY-NOTICES.md, split out of
             AboutPanel into their own screen (same rationale as
             AboutPanel's own doc comment: embedded WPF resources, no
             network access needed). -->
        <Grid x:Name="LicensePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="&#8592; ホーム" Style="{StaticResource BackButton}"
                    HorizontalAlignment="Left" Margin="12,12,0,0" Click="BackToHome_Click" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="ライセンス" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" Margin="0,0,0,20" />

                    <TextBlock Text="サードパーティ通知" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="ThirdPartyNoticesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Unity連携ガイド: 位置合わせモードのFOVガイド内「Unity連携は
             こちらから」ボタン(OpenUnityIntegrationGuideButton_Click)で開く、
             上から降りてくるオーバーレイ。HomePanel/AlignPanel/...のような
             画面切り替えではなく、ルートGridの最後に宣言することで今表示中の
             画面の上に重ねて表示する(Grid.RowSpan="2"でタイトルバーの下に
             かぶさる)。スクリムをクリックしても閉じる。 -->
        <Grid x:Name="UnityIntegrationGuideOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#88000000" MouseLeftButtonDown="UnityIntegrationGuideScrim_MouseLeftButtonDown" />
            <Border x:Name="UnityIntegrationGuidePanel" Style="{StaticResource Card}"
                    VerticalAlignment="Top" Margin="16,16,16,0" Padding="16"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="UnityIntegrationGuideTransform" Y="-400" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unity連携" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#10005;" Style="{StaticResource BackButton}"
                                Padding="8,4" Click="CloseUnityIntegrationGuideButton_Click" />
                    </Grid>

                    <TextBlock Text="① VCCにリポジトリを登録" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="下のボタンでVRChat Creator Companion(VCC)に、AvaSnap連携のパッケージリポジトリを登録します。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="VCCに追加" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left" Click="AddToVccButton_Click" />

                    <TextBlock Text="② プロジェクトへインストール" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="VCCで対象のUnityプロジェクトを開き、パッケージ一覧から「AvaSnap連携」を探してAddしてください。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- OSC有効化ガイド: 位置合わせモードのバナー「OSCを有効にする手順」ボタン
             (OpenOscSetupGuideButton_Click)から開く、Unity連携ガイドと同じ作りの
             上から降りてくるオーバーレイ。VRChat内ラジアルメニューの3ステップを
             簡易ラジアル図で示す。 -->
        <Grid x:Name="OscSetupGuideOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#88000000" MouseLeftButtonDown="OscSetupGuideScrim_MouseLeftButtonDown" />
            <Border x:Name="OscSetupGuidePanel" Style="{StaticResource Card}"
                    VerticalAlignment="Top" Margin="16,16,16,0" Padding="16"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="OscSetupGuideTransform" Y="-400" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VRChatでOSCを有効にする" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="&#10005;" Style="{StaticResource BackButton}"
                                Padding="8,4" Click="CloseOscSetupGuideButton_Click" />
                    </Grid>

                    <TextBlock Text="VRChat内でアクションメニュー（ラジアルメニュー）を開き、次の順に選びます。"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Viewbox Width="56" Height="56">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="40" Height="40"
                                             Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2" />
                                    <Line X1="24" Y1="24" X2="24" Y2="12" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="21" Canvas.Top="21" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <Ellipse Canvas.Left="18" Canvas.Top="2" Width="12" Height="12" Fill="{DynamicResource PrimaryBrush}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="① オプション" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Viewbox Width="56" Height="56">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="40" Height="40"
                                             Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2" />
                                    <Line X1="24" Y1="24" X2="15" Y2="33" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="21" Canvas.Top="21" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <Ellipse Canvas.Left="7" Canvas.Top="29" Width="12" Height="12" Fill="{DynamicResource PrimaryBrush}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="② OSC" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Viewbox Width="56" Height="56">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="40" Height="40"
                                             Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2" />
                                    <Line X1="24" Y1="24" X2="24" Y2="36" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="21" Canvas.Top="21" Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <Ellipse Canvas.Left="18" Canvas.Top="34" Width="12" Height="12" Fill="{DynamicResource PrimaryBrush}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="③「有効」をオン" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="うまく検知されない場合" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="・「有効」を一度オフ→オンし直す" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBlock Text="・直らなければ同じメニューの「設定をリセット」" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBlock Text="・他のOSCアプリ（VRCFaceTracking等）がポート9001を使用中だと受信できません。そのアプリを閉じるかVRChatを再起動してください"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBlock Text="・OSCの出力ポートを変更している場合は既定（9001）に戻してください" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </AdornerDecorator>
</Window>
